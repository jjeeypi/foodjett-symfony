# Copy this file to .env before running Docker Compose.
# Use URL-safe alphanumeric values for database credentials because Compose
# embeds them in Symfony's DATABASE_URL.

COMPOSE_PROJECT_NAME=foodjett

MARIADB_DATABASE=foodjett
MARIADB_USER=foodjett
MARIADB_PASSWORD=replace-with-a-strong-url-safe-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-strong-password

APP_SECRET=replace-with-a-long-random-application-secret
JWT_PASSPHRASE=replace-with-a-long-random-jwt-passphrase
MERCURE_JWT_SECRET=replace-with-a-long-random-mercure-secret

# Keep these public URLs in sync with the exposed ports below.
PUBLIC_WEB_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8000
WEB_PORT=8080
API_PORT=8000
MERCURE_PORT=3000
