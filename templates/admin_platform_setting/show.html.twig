{% extends 'base.html.twig' %}

{% block title %}PlatformSetting{% endblock %}

{% block body %}
    <h1>PlatformSetting</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ platform_setting.id }}</td>
            </tr>
            <tr>
                <th>Key</th>
                <td>{{ platform_setting.key }}</td>
            </tr>
            <tr>
                <th>Value</th>
                <td>{{ platform_setting.value }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ platform_setting.description }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ platform_setting.createdAt ? platform_setting.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ platform_setting.updatedAt ? platform_setting.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_platform_setting_index') }}">back to list</a>

    <a href="{{ path('app_admin_platform_setting_edit', {'id': platform_setting.id}) }}">edit</a>

    {{ include('admin_platform_setting/_delete_form.html.twig') }}
{% endblock %}
