{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Platform settings | Foodjett admin{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <div class="eyebrow">Platform</div>
            <h1>Platform settings</h1>
            <p>Fees, rider pay and timing rules the platform reads at run time. A setting that is missing uses its built-in default.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-light" href="{{ path('app_admin_delivery_zone_index') }}">{{ icon('map', 'icon-sm') }} Delivery zones</a>
            <a class="btn btn-green" href="{{ path('app_admin_platform_setting_new') }}">{{ icon('plus', 'icon-sm') }} Add a setting</a>
        </div>
    </div>

    <section class="panel">
        {% for platform_setting in platform_settings %}
            <div class="setting" id="setting-{{ platform_setting.key }}">
                <span>
                    <strong>{{ platform_setting.description ?: platform_setting.key }}</strong>
                    <small><code>{{ platform_setting.key }}</code>{% if platform_setting.updatedAt %} · updated {{ platform_setting.updatedAt|date('M j, Y g:i A') }}{% endif %}</small>
                </span>
                <span class="value">{{ platform_setting.value }}</span>
                <a class="btn btn-light btn-sm" href="{{ path('app_admin_platform_setting_edit', {'id': platform_setting.id}) }}">{{ icon('edit', 'icon-sm') }} edit</a>
            </div>
        {% else %}
            <div class="empty">{{ icon('settings', 'icon-xl') }}<h2>No settings stored; every default applies.</h2></div>
        {% endfor %}
    </section>
{% endblock %}
