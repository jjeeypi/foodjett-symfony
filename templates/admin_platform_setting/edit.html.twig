{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Edit setting | Foodjett admin{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_admin_platform_setting_index') }}">{{ icon('back', 'icon-sm') }} Platform settings</a>
    <div class="page-head">
        <div>
            <div class="eyebrow">Platform</div>
            <h1>Edit {{ platform_setting.key }}</h1>
        </div>
    </div>

    <div class="split">
        <section class="panel form-card">
            {{ include('admin_platform_setting/_form.html.twig', {'button_label': 'Update'}) }}
        </section>
        <aside class="stack">
            <section class="panel">
                <h2>{{ icon('help') }} Good to know</h2>
                <p class="subtle">The new value applies to orders placed after you save. Every change is written to the audit log.</p>
            </section>
        </aside>
    </div>
{% endblock %}
