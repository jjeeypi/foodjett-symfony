{% extends 'base.html.twig' %}

{% block title %}Orders | Foodjett{% endblock %}

{% block body %}
    <div id="live" {{ turbo_stream_listen('restaurant/' ~ app.user.restaurant.id ~ '/orders', null, {withCredentials: true}) }} hidden></div>
    <p><a href="{{ path('app_restaurant_dashboard') }}">Dashboard</a></p>
    <h1>Orders</h1>

    <form method="get" action="{{ path('app_restaurant_orders') }}">
        <label for="status">Status</label>
        <select id="status" name="status">
            <option value="">All</option>
            {% for value in statuses %}
                <option value="{{ value }}" {{ status == value ? 'selected' }}>{{ value|replace({'_': ' '}) }}</option>
            {% endfor %}
        </select>
        <label for="search">Order number or customer</label>
        <input type="search" id="search" name="search" value="{{ search }}">
        <button type="submit">Filter</button>
    </form>

    <table>
        <thead>
            <tr><th>Order</th><th>Customer</th><th>Items</th><th>Status</th><th>Total</th><th>Placed</th></tr>
        </thead>
        <tbody>
            {% for order in orders %}
                <tr>
                    <td><a href="{{ path('app_restaurant_order_detail', {id: order.id}) }}">{{ order.orderNumber }}</a></td>
                    <td>{{ order.customer.user.name }}</td>
                    <td>
                        {% for item in order.items %}
                            {{ item.quantity }} × {{ item.menuItem.name }}{% if item.menuItemVariant %} ({{ item.menuItemVariant.name }}){% endif %}
                            {% if item.specialInstructions %}· {{ item.specialInstructions }}{% endif %}<br>
                        {% endfor %}
                        {% if order.customerNotes %}Notes: {{ order.customerNotes }}{% endif %}
                    </td>
                    <td>{{ order.status|replace({'_': ' '}) }}</td>
                    <td>₱{{ order.totalAmount }}</td>
                    <td>{{ order.placedAt|date('M j, g:i A') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="6">No orders match.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    {{ knp_pagination_render(orders) }}
{% endblock %}
