{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon, status_badge %}

{% block title %}Orders | Foodjett{% endblock %}

{% block body %}
    <div id="live" {{ turbo_stream_listen('restaurant/' ~ app.user.restaurant.id ~ '/orders', null, {withCredentials: true}) }} hidden></div>
    <div class="page-head">
        <div>
            <div class="eyebrow">Kitchen</div>
            <h1>Orders</h1>
            <p>New orders appear here on their own. Open one to accept it and set the prep time.</p>
        </div>
        <div class="page-actions"><span class="badge badge-green"><i class="dot"></i> Live</span></div>
    </div>

    <div class="toolbar">
        <nav class="tabs" aria-label="Order views">
            <a class="{{ board is not null ? 'current' }}" href="{{ path('app_restaurant_orders') }}">Board</a>
            <a class="{{ board is null and status is null ? 'current' }}" href="{{ path('app_restaurant_orders', {view: 'list'}) }}">All orders</a>
            <a class="{{ status == 'placed' ? 'current' }}" href="{{ path('app_restaurant_orders', {status: 'placed'}) }}">Waiting</a>
            <a class="{{ status == 'delivered' ? 'current' }}" href="{{ path('app_restaurant_orders', {status: 'delivered'}) }}">Delivered</a>
        </nav>
        <form method="get" action="{{ path('app_restaurant_orders') }}">
            <input type="hidden" name="view" value="list">
            <div>
                <label for="status" class="sr-only">Status</label>
                <select id="status" name="status">
                    <option value="">Any status</option>
                    {% for value in statuses %}
                        <option value="{{ value }}" {{ status == value ? 'selected' }}>{{ value|replace({'_': ' '}) }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="search">
                {{ icon('search') }}
                <label for="search" class="sr-only">Order number</label>
                <input type="search" id="search" name="search" value="{{ search }}" placeholder="Order number">
            </div>
            <button type="submit" class="btn-light">Filter</button>
        </form>
    </div>

    {% if board is not null %}
        <div class="board">
            {% for key, stage in stages %}
                {% set column = board|filter(o => o.status in stage[1]) %}
                <section class="board-col" id="stage-{{ key }}">
                    <h2><i class="dot{{ key == 'new' ? ' dot-warn' : (key == 'on_the_way' ? ' dot-off' : '') }}"></i> {{ stage[0] }} <b>{{ column|length }}</b></h2>
                    {% for order in column %}
                        <a class="ticket{{ order.status == 'placed' ? ' urgent' }}" href="{{ path('app_restaurant_order_detail', {id: order.id}) }}">
                            <span class="ticket-top">
                                <strong class="order-number">{{ order.orderNumber }}</strong>
                                <small>
                                    {%- if key == 'preparing' and order.estimatedReadyAt %}Ready by {{ order.estimatedReadyAt|date('g:i A') }}
                                    {%- elseif key == 'ready' and order.readyAt %}Ready {{ order.readyAt|date('g:i A') }}
                                    {%- else %}{{ order.placedAt|date('g:i A') }}{% endif -%}
                                </small>
                            </span>
                            <span class="ticket-who">
                                {%- if order.rider and key != 'new' %}Rider: {{ order.rider.user.name }}{% else %}{{ order.customer.user.name }}{% endif %} · {{ order.paymentMethod|upper -}}
                            </span>
                            <ul>
                                {% for item in order.items %}
                                    <li><b>{{ item.quantity }}×</b> <span>{{ item.menuItem.name }}{% if item.menuItemVariant %} ({{ item.menuItemVariant.name }}){% endif %}{% if item.specialInstructions %} <small class="subtle">· {{ item.specialInstructions }}</small>{% endif %}</span></li>
                                {% endfor %}
                            </ul>
                            {% if order.customerNotes %}<p class="note">{{ order.customerNotes }}</p>{% endif %}
                            <span class="ticket-foot">
                                <strong>₱{{ order.subtotal }}</strong>
                                {% if key == 'new' %}<span class="btn btn-green btn-sm">Review</span>
                                {% elseif key == 'ready' and order.pickupCode %}<span class="badge badge-ink">Code {{ order.pickupCode }}</span>
                                {% else %}{{ status_badge(order.status) }}{% endif %}
                            </span>
                        </a>
                    {% else %}
                        <p class="empty-col">Nothing here.</p>
                    {% endfor %}
                </section>
            {% endfor %}
        </div>
    {% else %}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Order</th><th>Customer</th><th>Items</th><th>Status</th><th class="num">Total</th><th>Placed</th></tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                        <tr>
                            <td><a href="{{ path('app_restaurant_order_detail', {id: order.id}) }}"><b>{{ order.orderNumber }}</b></a></td>
                            <td>{{ order.customer.user.name }}</td>
                            <td>
                                {% for item in order.items %}
                                    {{ item.quantity }} × {{ item.menuItem.name }}{% if item.menuItemVariant %} ({{ item.menuItemVariant.name }}){% endif %}
                                    {% if item.specialInstructions %}<small class="subtle">· {{ item.specialInstructions }}</small>{% endif %}<br>
                                {% endfor %}
                                {% if order.customerNotes %}<small class="subtle">Notes: {{ order.customerNotes }}</small>{% endif %}
                            </td>
                            <td>{{ status_badge(order.status) }}</td>
                            <td class="num">₱{{ order.totalAmount }}</td>
                            <td>{{ order.placedAt|date('M j, g:i A') }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6">No orders match.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {{ knp_pagination_render(orders) }}
    {% endif %}
{% endblock %}
