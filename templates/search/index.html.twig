{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}{{ query ? query ~ ' | ' }}Search | Foodjett{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <div class="eyebrow">What’s your craving?</div>
            <h1>Search <span>dishes.</span></h1>
            <p>Every restaurant and every dish you can order right now. Type a few words, like garlic rice or milk tea.</p>
        </div>
    </div>

    <div class="filter-bar">
        <form method="get" action="{{ path('app_search') }}" role="search">
            <div class="search-box search-field" data-controller="search-suggestions" data-search-suggestions-url-value="{{ path('app_search_suggestion') }}">
                <label class="search" for="q">{{ icon('search', 'icon-sm') }}<span class="sr-only">Restaurant or dish</span>
                    <input type="search" id="q" name="q" value="{{ query }}" placeholder="Restaurant or dish, like sisig or Starbucks" autocomplete="off"
                           data-search-suggestions-target="input" data-action="input->search-suggestions#query keydown->search-suggestions#navigate">
                </label>
                <div class="suggestions" id="search-suggestions" role="listbox" aria-label="Suggestions" data-search-suggestions-target="list" hidden></div>
            </div>
            <label class="chip" for="category"><span class="sr-only">Category</span>
                <input type="text" id="category" name="category" value="{{ filters.category }}" placeholder="Category" style="border: 0; min-height: 38px; padding: 0; width: 120px; background: none">
            </label>
            <label class="chip" for="min_price">₱<span class="sr-only">Min price</span>
                <input type="text" id="min_price" name="min_price" value="{{ filters.min_price }}" inputmode="decimal" placeholder="Min" style="border: 0; min-height: 38px; padding: 0; width: 64px; background: none">
            </label>
            <label class="chip" for="max_price">₱<span class="sr-only">Max price</span>
                <input type="text" id="max_price" name="max_price" value="{{ filters.max_price }}" inputmode="decimal" placeholder="Max" style="border: 0; min-height: 38px; padding: 0; width: 64px; background: none">
            </label>
            {% if sort != 'relevance' %}<input type="hidden" name="sort" value="{{ sort }}">{% endif %}
            <button type="submit">{{ icon('search', 'icon-sm') }} Search</button>
        </form>
    </div>

    {% for error in errors %}
        <p class="error callout callout-danger" role="alert">{{ error }}</p>
    {% endfor %}

    {% if searched and errors is empty %}
        <p class="subtle" id="result-summary">
            {{ total }} {{ total == 1 ? 'dish' : 'dishes' }}
            {%- if terms is not empty %} and {{ restaurants|length }} {{ restaurants|length == 1 ? 'restaurant' : 'restaurants' }}{% endif %}
            {%- if query %} for “{{ query }}”{% endif %}
        </p>

        {% if suggestion %}
            <p class="callout" id="did-you-mean">{{ icon('search', 'icon-sm') }} <span>Did you mean <a href="{{ path('app_search', {q: suggestion}) }}"><strong>{{ suggestion }}</strong></a>?</span></p>
        {% endif %}

        {% if terms is not empty %}
            <h2>Restaurants</h2>
            <ul class="result-list">
                {% for restaurant in restaurants %}
                    <li>
                        <span class="grow">
                            <a href="{{ path('app_restaurant_menu', {slug: restaurant.slug}) }}">{{ restaurant.name|highlight(terms) }}</a>
                            <span class="subtle">· {{ restaurant.kindLabel }}{% if restaurant.cuisineType %} · {{ restaurant.cuisineType|highlight(terms) }}{% endif %}</span>
                        </span>
                        {% if restaurant.openNow %}<span class="badge badge-green"><i class="dot"></i> Open</span>{% else %}<span class="badge badge-ink">Closed</span>{% endif %}
                    </li>
                {% else %}
                    <li class="subtle">No restaurants match.</li>
                {% endfor %}
            </ul>
        {% endif %}

        {% if total > 1 %}
            <nav class="sort-links" aria-label="Sort dishes">
                <span class="subtle">Sort:</span>
                {% for key, label in sorts|filter((label, key) => terms is not empty or key != 'relevance') %}
                    <a class="chip{{ sort == key ? ' current' }}" href="{{ path('app_search', app.request.query.all|merge({sort: key})|filter((value, name) => name != 'page')) }}" {% if sort == key %}aria-current="true"{% endif %}>{{ label }}</a>
                {% endfor %}
            </nav>
        {% endif %}

        <h2>Dishes you can order now</h2>
        <ul class="result-list dishes">
            {% for item in dishes %}
                {% set restaurant = item.menuCategory.restaurant %}
                <li>
                    <span class="dish-photo" style="width: 56px; height: 56px">{% if item.photoPath %}<img src="{{ asset(item.photoPath) }}" alt="" width="56" height="56" loading="lazy">{% endif %}</span>
                    <span class="grow">
                        <a href="{{ path('app_restaurant_menu', {slug: restaurant.slug}) }}#item-{{ item.id }}">{{ item.name|highlight(terms) }}</a>
                        <span class="subtle" style="display: block">₱{{ item.basePrice }} · {{ restaurant.name|highlight(terms) }} · {{ item.menuCategory.name|highlight(terms) }}</span>
                        {% if terms is not empty and item.description %}<span class="subtle result-snippet">{{ item.description|highlight(terms) }}</span>{% endif %}
                    </span>
                </li>
            {% else %}
                <li class="subtle">No dishes match.</li>
            {% endfor %}
        </ul>
        {{ knp_pagination_render(dishes) }}
    {% else %}
        <div class="empty">{{ icon('search') }}<h2>Hungry for something?</h2><p>Type a dish, a restaurant or a category. Every word you type has to match, so two words find exactly what you want.</p></div>
    {% endif %}
{% endblock %}
