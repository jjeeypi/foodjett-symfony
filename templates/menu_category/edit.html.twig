{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Edit category | Foodjett{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_menu_category_index') }}">{{ icon('back', 'icon-sm') }} Menu categories</a>
    <div class="page-head">
        <div>
            <div class="eyebrow">Your menu</div>
            <h1>Edit menu category</h1>
        </div>
    </div>

    <div class="split">
        <section class="panel form-card">
            {{ include('menu_category/_form.html.twig', {'button_label': 'Update'}) }}
        </section>
        <aside class="stack">
            <section class="panel">
                <h2>{{ icon('help') }} Good to know</h2>
                <p class="subtle">A category that still has dishes cannot be deleted. Move or delete its dishes first.</p>
            </section>
            <section class="panel">
                <h2>Delete</h2>
                <p class="subtle">This cannot be undone.</p>
                {{ include('menu_category/_delete_form.html.twig') }}
            </section>
        </aside>
    </div>
{% endblock %}
