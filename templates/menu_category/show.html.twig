{% extends 'base.html.twig' %}

{% block title %}MenuCategory{% endblock %}

{% block body %}
    <h1>MenuCategory</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ menu_category.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ menu_category.name }}</td>
            </tr>
            <tr>
                <th>SortOrder</th>
                <td>{{ menu_category.sortOrder }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ menu_category.createdAt ? menu_category.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ menu_category.updatedAt ? menu_category.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_menu_category_index') }}">back to list</a>

    <a href="{{ path('app_menu_category_edit', {'id': menu_category.id}) }}">edit</a>

    {{ include('menu_category/_delete_form.html.twig') }}
{% endblock %}
