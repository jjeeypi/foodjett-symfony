{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Menu categories | Foodjett{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_menu_item_index') }}">{{ icon('back', 'icon-sm') }} Menu items</a>
    <div class="page-head">
        <div>
            <div class="eyebrow">Your menu</div>
            <h1>Menu categories</h1>
            <p>Categories group your dishes on your public page, in this order.</p>
        </div>
        <div class="page-actions"><a class="btn btn-green" href="{{ path('app_menu_category_new') }}">{{ icon('plus', 'icon-sm') }} Add a category</a></div>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th>Position</th><th>Name</th><th class="num">Dishes</th><th></th></tr>
            </thead>
            <tbody>
            {% for menu_category in menu_categories %}
                <tr>
                    <td><span class="badge badge-ink">{{ menu_category.sortOrder }}</span></td>
                    <td><strong>{{ menu_category.name }}</strong></td>
                    <td class="num">{{ menu_category.items|length }}</td>
                    <td class="actions">
                        <a class="btn btn-light btn-sm" href="{{ path('app_menu_category_edit', {'id': menu_category.id}) }}">{{ icon('edit', 'icon-sm') }} Edit</a>
                        {{ include('menu_category/_delete_form.html.twig') }}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4">No categories yet.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
