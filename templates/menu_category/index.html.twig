{% extends 'base.html.twig' %}

{% block title %}Menu categories | Foodjett{% endblock %}

{% block body %}
    <p><a href="{{ path('app_menu_item_index') }}">Menu items</a></p>
    <h1>Menu categories</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Position</th>
                <th>Items</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for menu_category in menu_categories %}
            <tr>
                <td>{{ menu_category.name }}</td>
                <td>{{ menu_category.sortOrder }}</td>
                <td>{{ menu_category.items|length }}</td>
                <td>
                    <a href="{{ path('app_menu_category_edit', {'id': menu_category.id}) }}">edit</a>
                    {{ include('menu_category/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">No categories yet.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_menu_category_new') }}">Add a category</a>
{% endblock %}
