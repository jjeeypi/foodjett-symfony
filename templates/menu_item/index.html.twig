{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Menu items | Foodjett{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <div class="eyebrow">Your menu</div>
            <h1>Menu items</h1>
            <p>Turn a dish off when it runs out. Customers see the change right away.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-light" href="{{ path('app_menu_category_index') }}">{{ icon('list', 'icon-sm') }} Menu categories</a>
            <a class="btn btn-green" href="{{ path('app_menu_item_new') }}">{{ icon('plus', 'icon-sm') }} Add a menu item</a>
        </div>
    </div>

    <div class="menu-manager">
        <aside class="panel" style="padding: 8px">
            <ul class="cat-list">
                <li><a class="current" href="#dishes"><span class="handle">{{ icon('menu-book', 'icon-sm') }}</span>All dishes<b>{{ menu_items|length }}</b></a></li>
                {% for category in menu_categories %}
                    <li><a href="#category-{{ category.id }}"><span class="handle">{{ category.sortOrder }}</span>{{ category.name }}<b>{{ menu_items|filter(i => i.menuCategory.id == category.id)|length }}</b></a></li>
                {% endfor %}
            </ul>
            <a class="btn btn-light btn-sm btn-block" href="{{ path('app_menu_category_new') }}" style="margin-top: 6px">{{ icon('plus', 'icon-sm') }} Add a category</a>
        </aside>

        <section class="panel" id="dishes">
            {% for category in menu_categories %}
                {% set dishes = menu_items|filter(i => i.menuCategory.id == category.id) %}
                <div class="panel-head" id="category-{{ category.id }}" style="{{ not loop.first ? 'margin-top: 22px' }}">
                    <h2>{{ category.name }}</h2>
                    <a class="btn btn-light btn-sm" href="{{ path('app_menu_category_edit', {id: category.id}) }}">{{ icon('edit', 'icon-sm') }} Rename</a>
                </div>
                <ul class="item-rows">
                    {% for menu_item in dishes %}
                        <li class="item-row{{ menu_item.available ? '' : ' off' }}" id="item-{{ menu_item.id }}">
                            <a class="thumb" href="{{ path('app_menu_item_show', {id: menu_item.id}) }}" tabindex="-1" aria-hidden="true">
                                {% if menu_item.photoPath %}<img src="{{ asset(menu_item.photoPath) }}" alt="" width="64" height="64" loading="lazy">{% else %}{{ menu_item.name|first|upper }}{% endif %}
                            </a>
                            <span>
                                <h3>
                                    <a href="{{ path('app_menu_item_show', {id: menu_item.id}) }}">{{ menu_item.name }}</a>
                                    {% if menu_item.featured %}<span class="badge badge-green">Featured</span>{% endif %}
                                    {% if menu_item.availableFrom or menu_item.availableUntil %}<span class="badge badge-warn">{{ menu_item.availableFrom ? menu_item.availableFrom|date('g:i A') : 'Opening' }} to {{ menu_item.availableUntil ? menu_item.availableUntil|date('g:i A') : 'closing' }}</span>{% endif %}
                                </h3>
                                <p>{{ menu_item.description ?: menu_item.menuCategory.name }}</p>
                            </span>
                            <span class="price">₱{{ menu_item.basePrice }}</span>
                            <form method="post" action="{{ path('app_menu_item_toggle', {'id': menu_item.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ menu_item.id) }}">
                                <button type="submit" class="switch{{ menu_item.available ? ' on' }}"><i></i><span aria-hidden="true">{{ menu_item.available ? 'Available' : 'Sold out' }}</span> <span class="sr-only">{{ menu_item.available ? 'Mark unavailable' : 'Mark available' }}</span></button>
                            </form>
                            <a class="icon-button" href="{{ path('app_menu_item_edit', {'id': menu_item.id}) }}" title="Edit {{ menu_item.name }}" aria-label="Edit {{ menu_item.name }}">{{ icon('edit') }}</a>
                        </li>
                    {% else %}
                        <li class="subtle" style="padding: 10px 0">No dishes in this category yet.</li>
                    {% endfor %}
                </ul>
            {% else %}
                <div class="empty">
                    {{ icon('menu-book', 'icon-xl') }}
                    <h2>No menu items yet.</h2>
                    <p>Add a category first, then your dishes.</p>
                    <a class="btn btn-green" href="{{ path('app_menu_category_new') }}">Add a category</a>
                </div>
            {% endfor %}
        </section>
    </div>
{% endblock %}
