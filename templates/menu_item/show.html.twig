{% extends 'base.html.twig' %}

{% block title %}MenuItem{% endblock %}

{% block body %}
    <h1>MenuItem</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ menu_item.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ menu_item.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ menu_item.description }}</td>
            </tr>
            <tr>
                <th>PhotoPath</th>
                <td>{{ menu_item.photoPath }}</td>
            </tr>
            <tr>
                <th>BasePrice</th>
                <td>{{ menu_item.basePrice }}</td>
            </tr>
            <tr>
                <th>IsAvailable</th>
                <td>{{ menu_item.isAvailable ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>AvailableFrom</th>
                <td>{{ menu_item.availableFrom ? menu_item.availableFrom|date('H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>AvailableUntil</th>
                <td>{{ menu_item.availableUntil ? menu_item.availableUntil|date('H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>IsFeatured</th>
                <td>{{ menu_item.isFeatured ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ menu_item.createdAt ? menu_item.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ menu_item.updatedAt ? menu_item.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_menu_item_index') }}">back to list</a>

    <a href="{{ path('app_menu_item_edit', {'id': menu_item.id}) }}">edit</a>

    {{ include('menu_item/_delete_form.html.twig') }}
{% endblock %}
