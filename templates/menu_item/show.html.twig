{% extends 'base.html.twig' %}

{% block title %}{{ menu_item.name }} | Foodjett{% endblock %}

{% block body %}
    <p><a href="{{ path('app_menu_item_index') }}">Menu items</a></p>
    <h1>{{ menu_item.name }}</h1>

    <table class="table">
        <tbody>
            <tr><th>Category</th><td>{{ menu_item.menuCategory.name }}</td></tr>
            <tr><th>Price</th><td>₱{{ menu_item.basePrice }}</td></tr>
            <tr><th>Description</th><td>{{ menu_item.description }}</td></tr>
            <tr><th>Available</th><td>{{ menu_item.available ? 'Yes' : 'No' }}{{ menu_item.featured ? ' · Featured' }}</td></tr>
            <tr>
                <th>Served</th>
                <td>
                    {% if menu_item.availableFrom or menu_item.availableUntil %}
                        {{ menu_item.availableFrom ? menu_item.availableFrom|date('H:i') : 'opening' }} to {{ menu_item.availableUntil ? menu_item.availableUntil|date('H:i') : 'closing' }}
                    {% else %}
                        all day
                    {% endif %}
                </td>
            </tr>
            {% if menu_item.photoPath %}<tr><th>Photo</th><td><img src="{{ asset(menu_item.photoPath) }}" alt="{{ menu_item.name }}" width="160"></td></tr>{% endif %}
        </tbody>
    </table>
    <a href="{{ path('app_menu_item_edit', {'id': menu_item.id}) }}">edit</a>

    <h2>Options</h2>
    <ul id="variants">
        {% for variant in menu_item.variants %}
            <li>
                {{ variant.name }} ({{ variant.priceDelta >= 0 ? '+' : '' }}{{ variant.priceDelta }})
                <a href="{{ path('app_menu_item_variant_edit', {'itemId': menu_item.id, 'id': variant.id}) }}">edit</a>
            </li>
        {% else %}
            <li>No options.</li>
        {% endfor %}
    </ul>
    <a href="{{ path('app_menu_item_variant_new', {'itemId': menu_item.id}) }}">Add an option</a>

    <h2>Add-ons</h2>
    <ul id="addons">
        {% for addon in menu_item.addons %}
            <li>
                {{ addon.name }} (+{{ addon.price }}){{ addon.available ? '' : ' · unavailable' }}
                <a href="{{ path('app_menu_item_addon_edit', {'itemId': menu_item.id, 'id': addon.id}) }}">edit</a>
            </li>
        {% else %}
            <li>No add-ons.</li>
        {% endfor %}
    </ul>
    <a href="{{ path('app_menu_item_addon_new', {'itemId': menu_item.id}) }}">Add an add-on</a>

    <h2>Delete</h2>
    {{ include('menu_item/_delete_form.html.twig') }}
{% endblock %}
