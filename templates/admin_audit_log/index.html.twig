{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Audit log | Foodjett admin{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <div class="eyebrow">Accountability</div>
            <h1>Audit log</h1>
            <p>Every change an admin made, newest first.</p>
        </div>
    </div>

    <form method="get">
        <div>
            <label for="action">Action contains</label>
            <input type="search" id="action" name="action" value="{{ action }}" placeholder="voucher, rider.suspended, ...">
        </div>
        <div>
            <label for="from">From</label>
            <input type="date" id="from" name="from" value="{{ from ? from|date('Y-m-d') }}">
        </div>
        <div>
            <label for="to">to</label>
            <input type="date" id="to" name="to" value="{{ to ? to|date('Y-m-d') }}">
        </div>
        <button type="submit" class="btn-light">Filter</button>
    </form>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th>When</th><th>Admin</th><th>Action</th><th>Subject</th><th>Changes</th></tr>
            </thead>
            <tbody>
            {% for log in logs %}
                <tr id="log-{{ log.id }}">
                    <td style="white-space: nowrap">{{ log.createdAt|date('M j, Y g:i:s A') }}</td>
                    <td>{{ log.user ? log.user.name : 'system' }}</td>
                    <td class="action"><span class="badge badge-ink">{{ log.action }}</span></td>
                    <td>{{ log.subjectType|replace({'_': ' '}) }} #{{ log.subjectId }}</td>
                    <td><code style="font-size: 12px; word-break: break-all">{{ log.changes|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</code></td>
                </tr>
            {% else %}
                <tr><td colspan="5">no records found</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {{ knp_pagination_render(logs) }}
{% endblock %}
