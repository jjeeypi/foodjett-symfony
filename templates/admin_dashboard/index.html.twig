{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Admin dashboard | Foodjett{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <div class="eyebrow">Admin console</div>
            <h1>Good day, <span>{{ app.user.name|split(' ')|first }}.</span></h1>
            <p>Everything happening on Foodjett, at a glance.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-light" href="{{ path('app_admin_restaurant_index', {approval: 'pending'}) }}">{{ icon('store', 'icon-sm') }} Restaurant applications</a>
            <a class="btn btn-light" href="{{ path('app_admin_rider_index', {approval: 'pending'}) }}">{{ icon('bike', 'icon-sm') }} Rider applications</a>
            <a class="btn btn-green" href="{{ path('app_admin_unassigned_order') }}">{{ icon('receipt', 'icon-sm') }} Waiting for a rider</a>
        </div>
    </div>

    {% set money_words = ['revenue', 'amount', 'sales', 'commission', 'gmv', 'fees', 'payout'] %}
    {% for section, values in stats %}
        {% if values is iterable %}
            <section id="{{ section }}" class="panel" style="margin-bottom: 20px">
                <h2>{{ section|replace({'_': ' '})|capitalize }}</h2>
                <dl class="stats" style="margin: 16px 0 0">
                    {% for key, value in values %}
                        <div>
                            <dt>{{ key|replace({'_': ' '})|capitalize }}</dt>
                            {% if value is iterable %}
                                <dd style="font: 500 13px 'DM Sans', sans-serif; letter-spacing: 0">
                                    <dl>
                                        {% for part, count in value %}
                                            <div style="display: flex; justify-content: space-between; gap: 8px"><dt style="text-transform: none; letter-spacing: 0; font-size: 12px">{{ part|replace({'_': ' '})|capitalize }}</dt>
                                            <dd id="{{ section }}-{{ key }}-{{ part }}" style="margin: 0; font-weight: 700">{{ count }}</dd></div>
                                        {% endfor %}
                                    </dl>
                                </dd>
                            {% else %}
                                {% set is_money = money_words|filter(w => w in key)|length > 0 %}
                                <dd id="{{ section }}-{{ key }}" class="{{ is_money ? 'money' }}">{{ value }}</dd>
                            {% endif %}
                        </div>
                    {% endfor %}
                </dl>
            </section>
        {% else %}
            <p class="subtle"><small>{{ section|replace({'_': ' '}) }}: {{ values }}</small></p>
        {% endif %}
    {% endfor %}
{% endblock %}
