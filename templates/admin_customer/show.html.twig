{% extends 'base.html.twig' %}

{% block title %}{{ customer.user.name }} | Foodjett admin{% endblock %}

{% block body %}
    <p><a href="{{ path('app_admin_customer_index') }}">back to list</a></p>
    <h1>{{ customer.user.name }}</h1>

    <table class="table">
        <tbody>
            <tr><th>Contact</th><td>{{ customer.user.email }} · {{ customer.user.phone }}</td></tr>
            <tr><th>Orders</th><td id="order-summary">{{ order_count }} orders, ₱{{ lifetime_spend }} spent</td></tr>
        </tbody>
    </table>

    <h2>Account</h2>
    <p id="account">Login is <strong>{{ customer.user.status }}</strong>.</p>
    <form method="post" action="{{ path('app_admin_customer_account', {'id': customer.id, 'status': customer.user.status == 'active' ? 'suspended' : 'active'}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('account' ~ customer.id) }}">
        <button type="submit">{{ customer.user.status == 'active' ? 'Suspend account' : 'Reactivate account' }}</button>
    </form>

    <h2>Recent orders</h2>
    <ul>
        {% for order in recent_orders %}
            <li>{{ order.orderNumber }} · {{ order.restaurant.name }} · {{ order.status|replace({'_': ' '}) }} · ₱{{ order.totalAmount }} · {{ order.placedAt|date('M j, Y') }}</li>
        {% else %}
            <li>No orders yet.</li>
        {% endfor %}
    </ul>
{% endblock %}
