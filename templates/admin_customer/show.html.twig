{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon, status_badge %}

{% block title %}{{ customer.user.name }} | Foodjett admin{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_admin_customer_index') }}">{{ icon('back', 'icon-sm') }} Customers</a>

    <div class="order-head">
        <div class="person">
            <span class="avatar avatar-lg">{{ customer.user.name|split(' ')|map(p => p|first)|slice(0, 2)|join|upper }}</span>
            <span class="grow">
                {{ status_badge(customer.user.status) }}
                <h1>{{ customer.user.name }}</h1>
                <small>{{ customer.user.email }} · {{ customer.user.phone }}</small>
            </span>
        </div>
    </div>

    <div class="split">
        <section class="panel">
            <div class="panel-head">
                <h2>Recent orders</h2>
                <span class="subtle" id="order-summary">{{ order_count }} orders, ₱{{ lifetime_spend }} spent</span>
            </div>
            <ul class="receipt">
                {% for order in recent_orders %}
                    <li>
                        <span class="qty-tag">{{ icon('receipt', 'icon-sm') }}</span>
                        <span><strong>{{ order.orderNumber }}</strong><small>{{ order.restaurant.name }} · {{ order.placedAt|date('M j, Y') }} · {{ order.status|replace({'_': ' '}) }}</small></span>
                        <span>₱{{ order.totalAmount }}</span>
                    </li>
                {% else %}
                    <li><span></span><span class="subtle">No orders yet.</span><span></span></li>
                {% endfor %}
            </ul>
        </section>

        <aside class="panel">
            <h2>Account</h2>
            <p id="account" class="subtle">Login is <strong>{{ customer.user.status }}</strong>.</p>
            <form method="post" action="{{ path('app_admin_customer_account', {'id': customer.id, 'status': customer.user.status == 'active' ? 'suspended' : 'active'}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('account' ~ customer.id) }}">
                <button type="submit" class="{{ customer.user.status == 'active' ? 'btn-light' : 'btn-green' }}">{{ customer.user.status == 'active' ? 'Suspend account' : 'Reactivate account' }}</button>
            </form>
        </aside>
    </div>
{% endblock %}
