{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Waiting for a rider | Foodjett admin{% endblock %}

{% block body %}
    <div id="live" {{ turbo_stream_listen('orders/pool') }} hidden></div>
    <a class="back-link" href="{{ path('app_admin_order') }}">{{ icon('back', 'icon-sm') }} All orders</a>
    <div class="page-head">
        <div>
            <div class="eyebrow">Needs a hand</div>
            <h1>Waiting for a rider</h1>
            <p>Orders the rider pool could not place in time. Open one to hand it to a rider.</p>
        </div>
        <div class="page-actions"><span class="badge badge-green"><i class="dot"></i> Live</span></div>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th>Order</th><th>Restaurant</th><th>Searching</th><th>Stage</th><th class="num">Radius</th><th class="num">Incentive</th><th></th></tr>
            </thead>
            <tbody>
            {% for order in orders %}
                {% set minutes = order.riderSearchStartedAt ? ((now.timestamp - order.riderSearchStartedAt.timestamp) / 60)|round(0, 'floor') : 0 %}
                <tr id="order-{{ order.id }}">
                    <td><a href="{{ path('app_admin_order_detail', {id: order.id}) }}"><b>{{ order.orderNumber }}</b></a></td>
                    <td>{{ order.restaurant.name }}</td>
                    <td><span class="badge {{ minutes >= 10 ? 'badge-danger' : 'badge-warn' }}"><span class="minutes">{{ minutes }} min</span></span></td>
                    <td>{{ order.riderPoolOffer.escalationStage|replace({'_': ' '}) }}</td>
                    <td class="num">{{ order.riderPoolOffer.searchRadiusKm }} km</td>
                    <td class="num">₱{{ order.riderPoolOffer.incentiveAmount }}</td>
                    <td class="actions"><a class="btn btn-green btn-sm" href="{{ path('app_admin_order_detail', {id: order.id}) }}">Assign</a></td>
                </tr>
            {% else %}
                <tr><td colspan="7">Every order has a rider.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {{ knp_pagination_render(orders) }}
{% endblock %}
