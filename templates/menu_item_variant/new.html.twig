{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}New option | Foodjett{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_menu_item_show', {'id': menu_item.id}) }}">{{ icon('back', 'icon-sm') }} {{ menu_item.name }}</a>
    <div class="page-head">
        <div>
            <div class="eyebrow">Options</div>
            <h1>Add an option to {{ menu_item.name }}</h1>
            <p>An option is a choice like size or flavor.</p>
        </div>
    </div>

    <div class="split">
        <section class="panel form-card">
            {{ include('menu_item_variant/_form.html.twig') }}
        </section>
        <aside class="stack">
            <section class="panel">
                <h2>{{ icon('help') }} Good to know</h2>
                <p class="subtle">The price change is added to the base price. Use a negative amount for a cheaper option, like −10.00 for a small size.</p>
            </section>
        </aside>
    </div>
{% endblock %}
