<form method="post" action="{{ path('app_menu_item_variant_delete', {'itemId': menu_item.id, 'id': menu_item_variant.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ menu_item_variant.id) }}">
    <button class="btn">Delete</button>
</form>
