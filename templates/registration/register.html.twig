{% extends 'base.html.twig' %}

{% block title %}{{ heading }} | Foodjett{% endblock %}

{% block body %}
    <h1>{{ heading }}</h1>

    {# Only the restaurant application has an address, so only it gets the address picker. #}
    {{ form_start(registrationForm, registrationForm.address is defined ? {attr: {'data-controller': 'location-picker', 'data-location-picker-coverage-url-value': path('app_delivery_coverage')}} : {}) }}
        {{ form_errors(registrationForm) }}
        {{ form_widget(registrationForm) }}

        <button type="submit">Submit</button>
    {{ form_end(registrationForm) }}

    <p>
        Sign up as a <a href="{{ path('app_register') }}">customer</a>,
        apply as a <a href="{{ path('app_register_restaurant') }}">restaurant</a>
        or as a <a href="{{ path('app_register_rider') }}">rider</a>.
        Already registered? <a href="{{ path('app_login') }}">Log in</a>.
    </p>
{% endblock %}
