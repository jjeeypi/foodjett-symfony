{% extends 'base.html.twig' %}
{% set auth_page = {eyebrow: 'It happens to the best of us', headline: 'Back to good<br>food soon.', image: 'images/catalog/covers/starbucks.webp'} %}

{% block title %}Reset your password{% endblock %}

{% block body %}
