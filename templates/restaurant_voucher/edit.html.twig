{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Edit voucher | Foodjett{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_restaurant_voucher_index') }}">{{ icon('back', 'icon-sm') }} Your vouchers</a>
    <div class="page-head">
        <div>
            <div class="eyebrow">Promotions</div>
            <h1>Edit voucher {{ voucher.code }}</h1>
        </div>
    </div>

    <div class="split">
        <section class="panel form-card">
            {{ include('restaurant_voucher/_form.html.twig', {'button_label': 'Update'}) }}
        </section>
        <aside class="stack">
            <section class="panel">
                <h2>{{ icon('help') }} Good to know</h2>
                <p class="subtle">Untick “active” to pause a voucher without losing its history.</p>
            </section>
            <section class="panel">
                <h2>Delete</h2>
                <p class="subtle">This cannot be undone.</p>
                {{ include('restaurant_voucher/_delete_form.html.twig') }}
            </section>
        </aside>
    </div>
{% endblock %}
