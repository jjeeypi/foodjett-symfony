{% extends 'base.html.twig' %}

{% block title %}Orders | Foodjett admin{% endblock %}

{% block body %}
    <p><a href="{{ path('app_admin_dashboard') }}">Dashboard</a> | <a href="{{ path('app_admin_unassigned_order') }}">Waiting for a rider</a></p>
    <h1>Orders</h1>

    <form method="get">
        <label for="status">Status</label>
        <select id="status" name="status">
            <option value="">All</option>
            {% for value in statuses %}
                <option value="{{ value }}" {{ status == value ? 'selected' }}>{{ value|replace({'_': ' '}) }}</option>
            {% endfor %}
        </select>
        <label for="from">Placed from</label>
        <input type="date" id="from" name="from" value="{{ from ? from|date('Y-m-d') }}">
        <label for="to">to</label>
        <input type="date" id="to" name="to" value="{{ to ? to|date('Y-m-d') }}">
        <button type="submit">Filter</button>
    </form>

    <table class="table">
        <thead>
            <tr><th>Order</th><th>Restaurant</th><th>Customer</th><th>Rider</th><th>Status</th><th>Total</th><th>Payment</th><th>Placed</th></tr>
        </thead>
        <tbody>
        {% for order in orders %}
            <tr id="order-{{ order.id }}">
                <td><a href="{{ path('app_admin_order_detail', {id: order.id}) }}">{{ order.orderNumber }}</a></td>
                <td>{{ order.restaurant.name }}</td>
                <td>{{ order.customer.user.name }}</td>
                <td>{{ order.rider ? order.rider.user.name : '-' }}</td>
                <td>{{ order.status|replace({'_': ' '}) }}</td>
                <td>₱{{ order.totalAmount }}</td>
                <td>{{ order.paymentMethod|upper }}</td>
                <td>{{ order.placedAt|date('M j, Y g:i A') }}</td>
            </tr>
        {% else %}
            <tr><td colspan="8">no records found</td></tr>
        {% endfor %}
        </tbody>
    </table>
    {{ knp_pagination_render(orders) }}
{% endblock %}
