{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon, status_badge %}

{% block title %}Orders | Foodjett admin{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <div class="eyebrow">Everything moving</div>
            <h1>Orders</h1>
            <p>Every order on Foodjett. Open one to step in.</p>
        </div>
        <div class="page-actions"><a class="btn btn-green" href="{{ path('app_admin_unassigned_order') }}">{{ icon('bike', 'icon-sm') }} Waiting for a rider</a></div>
    </div>

    <form method="get">
        <div>
            <label for="status">Status</label>
            <select id="status" name="status">
                <option value="">All</option>
                {% for value in statuses %}
                    <option value="{{ value }}" {{ status == value ? 'selected' }}>{{ value|replace({'_': ' '}) }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="from">Placed from</label>
            <input type="date" id="from" name="from" value="{{ from ? from|date('Y-m-d') }}">
        </div>
        <div>
            <label for="to">to</label>
            <input type="date" id="to" name="to" value="{{ to ? to|date('Y-m-d') }}">
        </div>
        <button type="submit" class="btn-light">Filter</button>
    </form>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th>Order</th><th>Restaurant</th><th>Customer</th><th>Rider</th><th>Status</th><th class="num">Total</th><th>Payment</th><th>Placed</th></tr>
            </thead>
            <tbody>
            {% for order in orders %}
                <tr id="order-{{ order.id }}">
                    <td><a href="{{ path('app_admin_order_detail', {id: order.id}) }}"><b>{{ order.orderNumber }}</b></a></td>
                    <td>
                        <span class="entity">
                            <span class="thumb">{% if order.restaurant.coverPhotoPath %}<img src="{{ asset(order.restaurant.coverPhotoPath) }}" alt="" width="38" height="38" loading="lazy">{% else %}{{ order.restaurant.name|first|upper }}{% endif %}</span>
                            <strong>{{ order.restaurant.name }}</strong>
                        </span>
                    </td>
                    <td>{{ order.customer.user.name }}</td>
                    <td>{% if order.rider %}{{ order.rider.user.name }}{% else %}<span class="subtle">-</span>{% endif %}</td>
                    <td>{{ status_badge(order.status) }}</td>
                    <td class="num">₱{{ order.totalAmount }}</td>
                    <td>{{ order.paymentMethod|upper }}</td>
                    <td>{{ order.placedAt|date('M j, Y g:i A') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="8">no records found</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {{ knp_pagination_render(orders) }}
{% endblock %}
