{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Documents | Foodjett{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <div class="eyebrow">Rider workspace</div>
            <h1>Your <span>documents.</span></h1>
            <p>An admin checks each one before you can take orders.</p>
        </div>
    </div>

    <div class="table-wrap">
        <table>
            <thead><tr><th>Document</th><th>Status</th><th>Note from the admin</th><th>File</th></tr></thead>
            <tbody>
                {% for type in types %}
                    {% set document = documents[type] ?? null %}
                    {% set status = document ? document.status : 'missing' %}
                    <tr id="document-{{ type }}">
                        <td><strong>{{ type|replace({'_': ' '})|capitalize }}</strong></td>
                        <td><span class="badge {{ status == 'approved' ? 'badge-green' : (status in ['rejected', 'missing'] ? 'badge-danger' : 'badge-warn') }}">{{ status }}</span></td>
                        <td>{{ document ? document.rejectionReason }}</td>
                        <td>{% if document %}<a href="{{ path('app_rider_document_file', {id: document.id}) }}">view</a>{% endif %}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if form %}
        <section class="panel form-card" style="margin-top: 22px">
            <h2>Upload a document</h2>
            {{ form_start(form) }}
                {{ form_widget(form) }}
                <button type="submit">{{ icon('file', 'icon-sm') }} Upload</button>
            {{ form_end(form) }}
        </section>
    {% else %}
        <p class="callout" style="margin-top: 22px">{{ icon('check') }} All documents are submitted.</p>
    {% endif %}
{% endblock %}
