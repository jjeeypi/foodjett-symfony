{% extends 'base.html.twig' %}

{% block title %}{{ restaurant.name }} | Foodjett{% endblock %}

{% block body %}
    <h1>{{ restaurant.name }}</h1>

    {% if stats is null %}
        <section id="approval">
            <h2>Application status: {{ restaurant.approvalStatus }}</h2>
            {% if restaurant.approvalStatus == 'rejected' %}
                <p>Your application was not approved.{% if restaurant.rejectionReason %} Reason: {{ restaurant.rejectionReason }}{% endif %}</p>
            {% else %}
                <p>An admin is reviewing your documents. You can set up your restaurant once it is approved.</p>
            {% endif %}
            <p><a href="{{ path('app_restaurant_documents') }}">Your documents</a></p>
        </section>
    {% else %}
        <form method="post" action="{{ path('app_restaurant_status') }}" id="operating-status">
            <input type="hidden" name="_token" value="{{ csrf_token('operating-status') }}">
            <label for="status">Status</label>
            <select id="status" name="status">
                {% for value in ['open', 'closed', 'temporarily_closed'] %}
                    <option value="{{ value }}" {{ restaurant.operatingStatus == value ? 'selected' }}>{{ value|replace({'_': ' '}) }}</option>
                {% endfor %}
            </select>
            <button type="submit">Change status</button>
        </form>
        <p>
            You are {{ restaurant.openNow ? 'open' : 'closed' }} for orders.
            <a href="{{ path('app_restaurant_orders', {status: 'placed'}) }}">{{ stats.waiting }} waiting for you</a>.
        </p>
        <dl id="today">
            <dt>Orders today</dt><dd>{{ stats.orders_today }}</dd>
            <dt>Delivered sales today</dt><dd>PHP {{ stats.revenue_today }}</dd>
        </dl>

        <h2>Recent orders</h2>
        <ul>
            {% for order in stats.recent %}
                <li>
                    <a href="{{ path('app_restaurant_order_detail', {id: order.id}) }}">{{ order.orderNumber }}</a>
                    · {{ order.status|replace({'_': ' '}) }} · PHP {{ order.totalAmount }} · {{ order.placedAt|date('M j, g:i A') }}
                </li>
            {% else %}
                <li>No orders yet.</li>
            {% endfor %}
        </ul>

        <p>
            <a href="{{ path('app_restaurant_orders') }}">All orders</a>
            | <a href="{{ path('app_menu_item_index') }}">Menu</a>
            | <a href="{{ path('app_restaurant_profile') }}">Profile</a>
            | <a href="{{ path('app_restaurant_hours') }}">Hours</a>
            | <a href="{{ path('app_restaurant_documents') }}">Documents</a>
            | <a href="{{ path('app_restaurant_earnings') }}">Earnings</a>
            | <a href="{{ path('app_restaurant_reviews') }}">Reviews</a>
            | <a href="{{ path('app_restaurant_voucher_index') }}">Vouchers</a>
        </p>
    {% endif %}
{% endblock %}
