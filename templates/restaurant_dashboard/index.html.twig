{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}{{ restaurant.name }} | Foodjett{% endblock %}

{% block body %}
    <div id="live" {% if stats %}{{ turbo_stream_listen('restaurant/' ~ restaurant.id ~ '/orders', null, {withCredentials: true}) }}{% endif %} hidden></div>
    <div class="page-head">
        <div>
            <div class="eyebrow">Restaurant workspace</div>
            <h1>{{ restaurant.name }}</h1>
            <p>{{ restaurant.kindLabel }} · {{ restaurant.cuisineType }} · {{ restaurant.address }}</p>
        </div>
        {% if stats %}<a class="btn btn-light" href="{{ path('app_restaurant_menu', {slug: restaurant.slug}) }}">{{ icon('store', 'icon-sm') }} View public page</a>{% endif %}
    </div>

    {% if stats is null %}
        <section id="approval" class="panel">
            <span class="badge {{ restaurant.approvalStatus == 'rejected' ? 'badge-danger' : 'badge-warn' }}">{{ restaurant.approvalStatus }}</span>
            <h2 style="margin-top: 12px">Application status: {{ restaurant.approvalStatus }}</h2>
            {% if restaurant.approvalStatus == 'rejected' %}
                <p class="subtle">Your application was not approved.{% if restaurant.rejectionReason %} Reason: {{ restaurant.rejectionReason }}{% endif %}</p>
            {% else %}
                <p class="subtle">An admin is reviewing your documents. You can set up your restaurant once it is approved.</p>
            {% endif %}
            <a class="btn btn-light" href="{{ path('app_restaurant_documents') }}">{{ icon('file', 'icon-sm') }} Your documents</a>
        </section>
    {% else %}
        <dl id="today" class="stats">
            <div><dt>Orders today</dt><dd>{{ stats.orders_today }}</dd></div>
            <div><dt>Delivered sales today</dt><dd>₱{{ stats.revenue_today }}</dd></div>
            <div><dt>Waiting for you</dt><dd><a href="{{ path('app_restaurant_orders', {status: 'placed'}) }}">{{ stats.waiting }}</a></dd></div>
            <div><dt>Rating</dt><dd>{{ restaurant.averageRating|number_format(1) }} ★</dd></div>
        </dl>

        <div class="split">
            <section class="panel">
                <div class="panel-head">
                    <h2>Recent orders</h2>
                    <a class="btn btn-light btn-sm" href="{{ path('app_restaurant_orders') }}">All orders {{ icon('arrow', 'icon-sm') }}</a>
                </div>
                {% for order in stats.recent %}
                    {% set terminal = order.status in constant('App\\Entity\\Order::TERMINAL_STATUSES') %}
                    <a class="line" href="{{ path('app_restaurant_order_detail', {id: order.id}) }}">
                        <span class="pin-box">{{ icon('receipt') }}</span>
                        <span class="grow"><strong>{{ order.orderNumber }}</strong><div class="subtle">{{ order.placedAt|date('M j, g:i A') }}</div></span>
                        <span class="badge {{ order.status == 'delivered' ? 'badge-green' : (terminal ? 'badge-danger' : 'badge-warn') }}">{{ order.status|replace({'_': ' '}) }}</span>
                        <span class="amount">₱{{ order.totalAmount }}</span>
                    </a>
                {% else %}
                    <p class="subtle">No orders yet.</p>
                {% endfor %}
            </section>

            <aside class="stack">
                <section class="panel">
                    <h2>Taking orders?</h2>
                    <p class="subtle">You are {{ restaurant.openNow ? 'open' : 'closed' }} for orders. <a href="{{ path('app_restaurant_orders', {status: 'placed'}) }}">{{ stats.waiting }} waiting for you</a>.</p>
                    <form method="post" action="{{ path('app_restaurant_status') }}" id="operating-status">
                        <input type="hidden" name="_token" value="{{ csrf_token('operating-status') }}">
                        <label for="status">Status</label>
                        <select id="status" name="status">
                            {% for value in ['open', 'closed', 'temporarily_closed'] %}
                                <option value="{{ value }}" {{ restaurant.operatingStatus == value ? 'selected' }}>{{ value|replace({'_': ' '}) }}</option>
                            {% endfor %}
                        </select>
                        <button type="submit" style="margin-top: 12px">Change status</button>
                    </form>
                </section>

                <nav class="panel" aria-label="Restaurant shortcuts">
                    <a class="line" href="{{ path('app_menu_item_index') }}"><span class="pin-box">{{ icon('menu-book') }}</span><span class="grow"><strong>Menu</strong><div class="subtle">Dishes, options and add-ons</div></span>{{ icon('arrow', 'icon-sm') }}</a>
                    <a class="line" href="{{ path('app_restaurant_hours') }}"><span class="pin-box">{{ icon('clock') }}</span><span class="grow"><strong>Hours</strong><div class="subtle">When you take orders</div></span>{{ icon('arrow', 'icon-sm') }}</a>
                    <a class="line" href="{{ path('app_restaurant_earnings') }}"><span class="pin-box">{{ icon('wallet') }}</span><span class="grow"><strong>Earnings</strong><div class="subtle">Sales and payouts</div></span>{{ icon('arrow', 'icon-sm') }}</a>
                    <a class="line" href="{{ path('app_restaurant_reviews') }}"><span class="pin-box">{{ icon('star') }}</span><span class="grow"><strong>Reviews</strong><div class="subtle">Reply to your customers</div></span>{{ icon('arrow', 'icon-sm') }}</a>
                </nav>
            </aside>
        </div>
    {% endif %}
{% endblock %}
