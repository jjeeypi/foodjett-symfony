{% extends 'base.html.twig' %}

{% block title %}Chat for order {{ conversation.order.orderNumber }} | Foodjett{% endblock %}

{% block body %}
    <div id="live" {{ turbo_stream_listen('conversations/' ~ conversation.id, null, {withCredentials: true}) }} hidden></div>
    <p><a href="{{ path('app_messages') }}">All messages</a></p>

    <h1>Chat for order {{ conversation.order.orderNumber }}</h1>
    <p>
        {% if conversation.type == constant('App\\Entity\\Conversation::TYPE_CUSTOMER_RESTAURANT') %}
            With {{ conversation.order.restaurant.name }} and the customer.
        {% else %}
            With the rider and the customer.
        {% endif %}
    </p>

    <ol id="messages">
        {% for message in messages %}
            <li>
                <strong>{{ message.sender.name }}</strong> · {{ message.createdAt|date('M j, g:i A') }}
                {% if message.sender == app.user and message.readAt %}· read{% endif %}
                <br><span class="body">{{ message.body|nl2br }}</span>
            </li>
        {% else %}
            <li>No messages yet.</li>
        {% endfor %}
    </ol>

    {% if form %}
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit">Send</button>
        {{ form_end(form) }}
    {% else %}
        <p>This conversation is read-only.</p>
    {% endif %}
{% endblock %}
