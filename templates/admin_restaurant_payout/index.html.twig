{% extends 'base.html.twig' %}

{% block title %}Restaurant payouts | Foodjett admin{% endblock %}

{% block body %}
    <p><a href="{{ path('app_admin_dashboard') }}">Dashboard</a> | <a href="{{ path('app_admin_rider_payout') }}">Rider payouts</a></p>
    <h1>Restaurant payouts</h1>

    <h2>Generate</h2>
    <p>One payout per restaurant: food sales on orders delivered in the period, minus commission. Restaurants already paid for an overlapping period are skipped.</p>
    {{ form_start(form, {action: path('app_admin_restaurant_payout_generate')}) }}
        {{ form_widget(form) }}
        <button type="submit">Generate payouts</button>
    {{ form_end(form) }}

    <h2>Payouts</h2>
    <form method="get">
        <label for="status">Status</label>
        <select id="status" name="status">
            <option value="">All</option>
            {% for value in statuses %}<option value="{{ value }}" {{ status == value ? 'selected' }}>{{ value }}</option>{% endfor %}
        </select>
        <button type="submit">Filter</button>
    </form>

    <table class="table">
        <thead>
            <tr><th>Restaurant</th><th>Period</th><th>Sales</th><th>Commission</th><th>Net</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
        {% for payout in payouts %}
            <tr id="payout-{{ payout.id }}">
                <td><a href="{{ path('app_admin_restaurant_show', {id: payout.restaurant.id}) }}">{{ payout.restaurant.name }}</a></td>
                <td>{{ payout.periodStart|date('M j, Y') }} to {{ payout.periodEnd|date('M j, Y') }}</td>
                <td>₱{{ payout.grossSales }}</td><td>₱{{ payout.commissionDeducted }}</td><td class="net">₱{{ payout.netAmount }}</td>
                <td class="status">{{ payout.status }}{% if payout.paidAt %} {{ payout.paidAt|date('M j, Y') }}{% endif %}</td>
                <td>
                    {% if payout.status == 'pending' %}
                        <form method="post" action="{{ path('app_admin_restaurant_payout_paid', {id: payout.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('payout' ~ payout.id) }}">
                            <button type="submit">Mark paid</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="7">no records found</td></tr>
        {% endfor %}
        </tbody>
    </table>
    {{ knp_pagination_render(payouts) }}
{% endblock %}
