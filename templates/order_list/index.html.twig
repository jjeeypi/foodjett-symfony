{% extends 'base.html.twig' %}

{% block title %}Your orders | Foodjett{% endblock %}

{% block body %}
    <h1>Your orders</h1>

    <p>
        Show: <a href="{{ path('app_orders') }}">All</a>
        | <a href="{{ path('app_orders', {filter: 'active'}) }}">Active</a>
        | <a href="{{ path('app_orders', {filter: 'past'}) }}">Past</a>
    </p>

    <table>
        <thead>
            <tr><th>Order</th><th>Restaurant</th><th>Status</th><th>Total</th><th>Placed</th></tr>
        </thead>
        <tbody>
            {% for order in orders %}
                <tr>
                    <td><a href="{{ path('app_order_detail', {id: order.id}) }}">{{ order.orderNumber }}</a></td>
                    <td>{{ order.restaurant.name }}</td>
                    <td>{{ order.status|replace({'_': ' '}) }}</td>
                    <td>PHP {{ order.totalAmount }}</td>
                    <td>{{ order.placedAt|date('M j, Y g:i A') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5">No orders yet.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    {{ knp_pagination_render(orders) }}
{% endblock %}
