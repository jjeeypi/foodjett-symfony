{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Your orders | Foodjett{% endblock %}

{% block body %}
    {% set filter = app.request.query.get('filter') %}
    <div class="page-head">
        <div>
            <div class="eyebrow">Your Foodjett</div>
            <h1>Your <span>orders.</span></h1>
            <p>Follow what’s cooking, and order your favorites again.</p>
        </div>
    </div>

    <div class="filter-bar">
        <a class="chip{{ filter not in ['active', 'past'] ? ' current' }}" href="{{ path('app_orders') }}">All</a>
        <a class="chip{{ filter == 'active' ? ' current' }}" href="{{ path('app_orders', {filter: 'active'}) }}">{{ icon('bike', 'icon-sm') }} Active</a>
        <a class="chip{{ filter == 'past' ? ' current' }}" href="{{ path('app_orders', {filter: 'past'}) }}">{{ icon('clock', 'icon-sm') }} Past</a>
    </div>

    <div class="stack">
        {% for order in orders %}
            {% set terminal = order.status in constant('App\\Entity\\Order::TERMINAL_STATUSES') %}
            {% set tone = order.status == 'delivered' ? 'badge-green' : (terminal ? 'badge-danger' : 'badge-warn') %}
            <a class="order-card" id="order-{{ order.id }}" href="{{ path('app_order_detail', {id: order.id}) }}">
                <span class="dish-photo" style="width: 72px; height: 72px">
                    {% if order.restaurant.coverPhotoPath %}<img src="{{ asset(order.restaurant.coverPhotoPath) }}" alt="" width="72" height="72">{% endif %}
                </span>
                <span class="grow">
                    <strong class="order-number">{{ order.orderNumber }}</strong>
                    <span class="order-restaurant">{{ order.restaurant.name }}</span>
                    <span class="subtle">{{ order.placedAt|date('M j, Y g:i A') }} · {{ order.items|length }} {{ order.items|length == 1 ? 'item' : 'items' }}</span>
                </span>
                <span class="badge {{ tone }}">{{ order.status|replace({'_': ' '}) }}</span>
                <span class="amount">₱{{ order.totalAmount }}</span>
                {{ icon('arrow', 'icon-sm') }}
            </a>
        {% else %}
            <div class="empty">
                {{ icon('bag') }}
                <h2>Your next great meal starts here</h2>
                <p>You haven’t placed an order{{ filter in ['active', 'past'] ? ' like that' : '' }} yet.</p>
                <a class="btn" href="{{ path('app_restaurants') }}">Explore restaurants {{ icon('arrow', 'icon-sm') }}</a>
            </div>
        {% endfor %}
    </div>
    {{ knp_pagination_render(orders) }}
{% endblock %}
