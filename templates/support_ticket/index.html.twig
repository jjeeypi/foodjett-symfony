{% extends 'base.html.twig' %}

{% block title %}SupportTicket index{% endblock %}

{% block body %}
    <h1>SupportTicket index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Subject</th>
                <th>Message</th>
                <th>Status</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for support_ticket in support_tickets %}
            <tr>
                <td>{{ support_ticket.id }}</td>
                <td>{{ support_ticket.subject }}</td>
                <td>{{ support_ticket.message }}</td>
                <td>{{ support_ticket.status }}</td>
                <td>{{ support_ticket.createdAt ? support_ticket.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ support_ticket.updatedAt ? support_ticket.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_support_ticket_show', {'id': support_ticket.id}) }}">show</a>
                    <a href="{{ path('app_support_ticket_edit', {'id': support_ticket.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_support_ticket_new') }}">Create new</a>
{% endblock %}
