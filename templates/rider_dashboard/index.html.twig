{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Rider | Foodjett{% endblock %}

{% block body %}
    <div id="live" {% if active_order %}{{ turbo_stream_listen('orders/' ~ active_order.id ~ '/status', null, {withCredentials: true}) }}{% endif %} hidden></div>
    <div class="page-head">
        <div>
            <div class="eyebrow">Rider workspace</div>
            <h1>Hi, {{ rider.user.name }}</h1>
            <p>{{ approved ? 'Here is your day on the road.' : 'Your application is being looked at.' }}</p>
        </div>
    </div>

    {% if not approved %}
        <section id="approval" class="panel">
            <span class="badge {{ rider.approvalStatus == 'rejected' ? 'badge-danger' : 'badge-warn' }}">{{ rider.approvalStatus }}</span>
            <h2 style="margin-top: 12px">Application status: {{ rider.approvalStatus }}</h2>
            {% if rider.approvalStatus == 'rejected' %}
                <p class="subtle">Your application was not approved.{% if rider.rejectionReason %} Reason: {{ rider.rejectionReason }}{% endif %}</p>
            {% else %}
                <p class="subtle">An admin is reviewing your documents. You can take orders once you are approved.</p>
            {% endif %}
            <a class="btn btn-light" href="{{ path('app_rider_documents') }}">{{ icon('file', 'icon-sm') }} Your documents</a>
        </section>
    {% else %}
        <dl id="today" class="stats">
            <div><dt>Deliveries today</dt><dd>{{ stats.deliveries_today }}</dd></div>
            <div><dt>Earned today</dt><dd>₱{{ stats.earned_today }}</dd></div>
            <div><dt>Earned this week</dt><dd>₱{{ stats.earned_week }}</dd></div>
            <div><dt>Cash on hand</dt><dd>₱{{ rider.cashOnHand }}{% if stats.cash_at_limit %} <em>remit soon</em>{% endif %}</dd></div>
        </dl>

        <div class="split">
            <div class="stack">
                <section class="panel" id="status-summary">
                    <div class="panel-head">
                        <div>
                            <h2>You are <strong>{{ rider.availabilityStatus }}</strong>.</h2>
                            <p class="subtle" style="margin: 4px 0 0">{{ rider.availabilityStatus == 'offline' ? 'Go online on your status page to get offers.' : 'Nearby offers show up in the order pool.' }}</p>
                        </div>
                        <a class="btn btn-light btn-sm" href="{{ path('app_rider_status') }}">{{ icon('pin', 'icon-sm') }} Status</a>
                    </div>
                    {% if active_order %}
                        <p id="active-order" class="callout" style="margin: 0">
                            {{ icon('bike') }}
                            <span>Delivering order {{ active_order.orderNumber }} ({{ active_order.status|replace({'_': ' '}) }}).
                            <a href="{{ path('app_rider_delivery') }}"><strong>Open delivery</strong></a></span>
                        </p>
                    {% else %}
                        <a class="btn" href="{{ path('app_rider_pool') }}">{{ icon('bag', 'icon-sm') }} Find orders</a>
                    {% endif %}
                </section>

                <section class="panel" id="recent-deliveries">
                    <div class="panel-head">
                        <h2>Recent deliveries</h2>
                        <a class="btn btn-light btn-sm" href="{{ path('app_rider_finance') }}">Earnings {{ icon('arrow', 'icon-sm') }}</a>
                    </div>
                    {% for earning in stats.recent %}
                        <div class="line">
                            <span class="pin-box">{{ icon('receipt') }}</span>
                            <span class="grow"><strong>{{ earning.order.restaurant.name }}</strong><div class="subtle">{{ earning.order.orderNumber }} · {{ earning.createdAt|date('M j, g:i A') }}</div></span>
                            <span class="amount">₱{{ earning.totalEarned }}</span>
                        </div>
                    {% else %}
                        <p class="subtle">No deliveries yet. Your first one shows up here.</p>
                    {% endfor %}
                </section>
            </div>

            <aside class="panel">
                <h2>Shortcuts</h2>
                <a class="line" href="{{ path('app_rider_pool') }}"><span class="pin-box">{{ icon('bag') }}</span><span class="grow"><strong>Order pool</strong><div class="subtle">Offers near you</div></span>{{ icon('arrow', 'icon-sm') }}</a>
                <a class="line" href="{{ path('app_messages') }}"><span class="pin-box">{{ icon('message') }}</span><span class="grow"><strong>Messages</strong><div class="subtle">Chat with customers</div></span>{{ icon('arrow', 'icon-sm') }}</a>
                <a class="line" href="{{ path('app_rider_finance') }}"><span class="pin-box">{{ icon('wallet') }}</span><span class="grow"><strong>Earnings and cash</strong><div class="subtle">Payouts and remittances</div></span>{{ icon('arrow', 'icon-sm') }}</a>
                <a class="line" href="{{ path('app_rider_account') }}"><span class="pin-box">{{ icon('user') }}</span><span class="grow"><strong>Account</strong><div class="subtle">Profile, documents and earnings</div></span>{{ icon('arrow', 'icon-sm') }}</a>
            </aside>
        </div>
    {% endif %}
{% endblock %}
