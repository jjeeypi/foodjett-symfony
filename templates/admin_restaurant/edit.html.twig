{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Edit restaurant | Foodjett admin{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_admin_restaurant_show', {'id': restaurant.id}) }}">{{ icon('back', 'icon-sm') }} {{ restaurant.name }}</a>
    <div class="page-head">
        <div>
            <div class="eyebrow">Partners</div>
            <h1>Edit {{ restaurant.name }}</h1>
        </div>
    </div>

    <div class="split">
        <section class="panel form-card">
            {{ include('admin_restaurant/_form.html.twig', {'button_label': 'Update'}) }}
        </section>
        <aside class="stack">
            <section class="panel">
                <h2>{{ icon('help') }} Good to know</h2>
                <p class="subtle">Commission applies to orders placed after you save. Pick the address on the map so riders find the right place.</p>
            </section>
        </aside>
    </div>
{% endblock %}
