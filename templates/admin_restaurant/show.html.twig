{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon, status_badge, cover %}

{% block title %}{{ restaurant.name }} | Foodjett admin{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_admin_restaurant_index') }}">{{ icon('back', 'icon-sm') }} Restaurants</a>

    <div class="review-hero">
        {{ cover(restaurant) }}
        <div>
            {{ status_badge(restaurant.approvalStatus) }}
            <h1>{{ restaurant.name }}</h1>
            <p>{{ restaurant.kindLabel }} · {{ restaurant.cuisineType }} · {{ restaurant.address }}</p>
        </div>
    </div>

    <div class="split">
        <div class="stack">
            <section class="panel">
                <div class="panel-head">
                    <h2>Details</h2>
                    <a class="btn btn-light btn-sm" href="{{ path('app_admin_restaurant_edit', {'id': restaurant.id}) }}">{{ icon('edit', 'icon-sm') }} edit</a>
                </div>
                <div class="table-wrap">
                    <table class="table kv">
                        <tbody>
                            <tr><th>Owner</th><td>{{ restaurant.user.name }} · {{ restaurant.user.email }} · {{ restaurant.user.phone }}</td></tr>
                            <tr><th>Type</th><td>{{ restaurant.kindLabel }}</td></tr>
                            <tr><th>Cuisine</th><td>{{ restaurant.cuisineType }}</td></tr>
                            <tr><th>Address</th><td>{{ restaurant.address }} <small class="subtle">({{ restaurant.latitude }}, {{ restaurant.longitude }})</small></td></tr>
                            <tr><th>Commission</th><td>{{ restaurant.commissionRate }}%</td></tr>
                            <tr><th>Minimum order</th><td>₱{{ restaurant.minOrderAmount }}</td></tr>
                            <tr><th>Status</th><td>{{ restaurant.operatingStatus|replace({'_': ' '}) }}</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="panel">
                <h2>Documents</h2>
                <div class="docs">
                    {% for document in restaurant.documents %}
                        <div class="doc {{ document.status }}" id="document-{{ document.id }}">
                            <span class="pin-box">{{ icon('file') }}</span>
                            <span>
                                <strong>{{ document.type|replace({'_': ' '})|capitalize }}</strong>
                                <small>{{ document.status }}{% if document.rejectionReason %}: {{ document.rejectionReason }}{% endif %} · <a href="{{ path('app_admin_restaurant_document_file', {'id': restaurant.id, 'documentId': document.id}) }}">view</a></small>
                            </span>
                            <div class="doc-actions">
                                {% if document.status == 'verified' %}{{ status_badge('verified') }}{% endif %}
                                {% if document.status != 'verified' %}
                                    <form method="post" action="{{ path('app_admin_restaurant_document_verify', {'id': restaurant.id, 'documentId': document.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('document' ~ document.id) }}">
                                        <button type="submit" class="btn-green btn-sm">Verify</button>
                                    </form>
                                {% endif %}

                            </div>
                            {% if document.status != 'rejected' %}
                                <details class="doc-reject">
                                    <summary>Reject this document</summary>
                                    {{ form_start(document_forms[document.id], {'action': path('app_admin_restaurant_document_reject', {'id': restaurant.id, 'documentId': document.id})}) }}
                                        {{ form_widget(document_forms[document.id]) }}
                                        <button type="submit" class="btn-light btn-sm">Reject document</button>
                                    {{ form_end(document_forms[document.id]) }}
                                    </details>
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="subtle">No documents uploaded.</p>
                    {% endfor %}
                </div>
            </section>
        </div>

        <aside class="stack decision">
            <section class="panel action-card">
                <h2>Application</h2>
                <p id="approval">Status: <strong>{{ restaurant.approvalStatus }}</strong>{% if restaurant.rejectionReason %} · {{ restaurant.rejectionReason }}{% endif %}</p>
                <ul class="checklist">
                    {% for document in restaurant.documents %}
                        <li class="{{ document.status != 'verified' ? 'todo' }}">{{ icon(document.status == 'verified' ? 'check' : (document.status == 'rejected' ? 'close' : 'clock')) }} {{ document.type|replace({'_': ' '})|capitalize }} {{ document.status }}</li>
                    {% endfor %}
                </ul>
                {% if restaurant.approvalStatus != 'approved' %}
                    <form method="post" action="{{ path('app_admin_restaurant_approve', {'id': restaurant.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ restaurant.id) }}">
                        <button type="submit" class="btn-green btn-block">Approve</button>
                    </form>
                {% endif %}
                {% if restaurant.approvalStatus != 'rejected' %}
                    {{ form_start(reject_form, {'action': path('app_admin_restaurant_reject', {'id': restaurant.id})}) }}
                        {{ form_widget(reject_form) }}
                        <button type="submit" class="btn-danger btn-block">Reject application</button>
                    {{ form_end(reject_form) }}
                {% endif %}
            </section>

            <section class="panel">
                <h2>Account</h2>
                <p id="account" class="subtle">Login is <strong>{{ restaurant.user.status }}</strong>.</p>
                <form method="post" action="{{ path('app_admin_restaurant_account', {'id': restaurant.id, 'status': restaurant.user.status == 'active' ? 'suspended' : 'active'}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('account' ~ restaurant.id) }}">
                    <button type="submit" class="{{ restaurant.user.status == 'active' ? 'btn-light' : 'btn-green' }}">{{ restaurant.user.status == 'active' ? 'Suspend account' : 'Reactivate account' }}</button>
                </form>
            </section>
        </aside>
    </div>
{% endblock %}
