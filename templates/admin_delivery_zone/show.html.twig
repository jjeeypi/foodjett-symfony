{% extends 'base.html.twig' %}

{% block title %}DeliveryZone{% endblock %}

{% block body %}
    <h1>DeliveryZone</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ delivery_zone.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ delivery_zone.name }}</td>
            </tr>
            <tr>
                <th>Polygon</th>
                <td>{{ delivery_zone.polygon ? delivery_zone.polygon|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>IsActive</th>
                <td>{{ delivery_zone.isActive ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ delivery_zone.createdAt ? delivery_zone.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ delivery_zone.updatedAt ? delivery_zone.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_delivery_zone_index') }}">back to list</a>

    <a href="{{ path('app_admin_delivery_zone_edit', {'id': delivery_zone.id}) }}">edit</a>

    {{ include('admin_delivery_zone/_delete_form.html.twig') }}
{% endblock %}
