{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Delivery zones | Foodjett admin{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <div class="eyebrow">Coverage</div>
            <h1>Delivery zones</h1>
            <p>Checkout refuses addresses outside every active zone. With no active zone, Foodjett delivers everywhere.</p>
        </div>
        <div class="page-actions"><a class="btn btn-green" href="{{ path('app_admin_delivery_zone_new') }}">{{ icon('plus', 'icon-sm') }} Add a zone</a></div>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th>Zone</th><th>Centre</th><th class="num">Radius</th><th>Active</th><th></th></tr>
            </thead>
            <tbody>
            {% for delivery_zone in delivery_zones %}
                <tr id="zone-{{ delivery_zone.id }}">
                    <td><div class="entity"><span class="thumb">{{ icon('map', 'icon-sm') }}</span><strong>{{ delivery_zone.name }}</strong></div></td>
                    <td>{{ delivery_zone.polygon.center[0] ?? '' }}, {{ delivery_zone.polygon.center[1] ?? '' }}</td>
                    <td class="num">{{ delivery_zone.polygon.radius_km ?? '' }} km</td>
                    <td class="active"><span class="badge {{ delivery_zone.active ? 'badge-green' }}">{{ delivery_zone.active ? 'Yes' : 'No' }}</span></td>
                    <td class="actions">
                        <a class="btn btn-light btn-sm" href="{{ path('app_admin_delivery_zone_show', {'id': delivery_zone.id}) }}">show</a>
                        <a class="btn btn-light btn-sm" href="{{ path('app_admin_delivery_zone_edit', {'id': delivery_zone.id}) }}">edit</a>
                        <form method="post" action="{{ path('app_admin_delivery_zone_toggle', {'id': delivery_zone.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ delivery_zone.id) }}">
                            <button type="submit" class="switch{{ delivery_zone.active ? ' on' }}"><i></i> {{ delivery_zone.active ? 'Switch off' : 'Switch on' }}</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5">No zones yet, so every address is accepted.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
