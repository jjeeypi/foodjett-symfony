{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Edit delivery zone | Foodjett admin{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_admin_delivery_zone_index') }}">{{ icon('back', 'icon-sm') }} Delivery zones</a>
    <div class="page-head">
        <div>
            <div class="eyebrow">Coverage</div>
            <h1>Edit {{ delivery_zone.name }}</h1>
        </div>
    </div>

    <div class="split">
        <section class="panel form-card">
            {{ include('admin_delivery_zone/_form.html.twig', {'button_label': 'Update'}) }}
        </section>
        <aside class="stack">
            <section class="panel">
                <h2>{{ icon('help') }} Good to know</h2>
                <p class="subtle">Switching a zone off is safer than deleting it.</p>
            </section>
            <section class="panel">
                <h2>Delete</h2>
                <p class="subtle">This cannot be undone.</p>
                {{ include('admin_delivery_zone/_delete_form.html.twig') }}
            </section>
        </aside>
    </div>
{% endblock %}
