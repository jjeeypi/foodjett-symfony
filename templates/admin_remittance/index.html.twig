{% extends 'base.html.twig' %}

{% block title %}Cash remittances | Foodjett admin{% endblock %}

{% block body %}
    <p><a href="{{ path('app_admin_dashboard') }}">Dashboard</a></p>
    <h1>Cash remittances</h1>
    <p>Confirm a remittance only once the money has arrived. It lowers the rider's cash on hand by the amount.</p>

    <form method="get">
        <label for="status">Status</label>
        <select id="status" name="status">
            <option value="">All</option>
            {% for value in statuses %}<option value="{{ value }}" {{ status == value ? 'selected' }}>{{ value }}</option>{% endfor %}
        </select>
        <button type="submit">Filter</button>
    </form>

    <table class="table">
        <thead>
            <tr><th>Rider</th><th>Amount</th><th>Reference</th><th>Cash on hand</th><th>Status</th><th>Sent</th><th></th></tr>
        </thead>
        <tbody>
        {% for remittance in remittances %}
            <tr id="remittance-{{ remittance.id }}">
                <td><a href="{{ path('app_admin_rider_show', {id: remittance.rider.id}) }}">{{ remittance.rider.user.name }}</a></td>
                <td>₱{{ remittance.amount }}</td>
                <td>{{ remittance.referenceNote }}</td>
                <td class="cash">₱{{ remittance.rider.cashOnHand }}</td>
                <td class="status">{{ remittance.status }}{% if remittance.confirmedByAdmin %} by {{ remittance.confirmedByAdmin.user.name }}{% endif %}</td>
                <td>{{ remittance.createdAt|date('M j, Y g:i A') }}</td>
                <td>
                    {% if remittance.status == 'pending' %}
                        <form method="post" action="{{ path('app_admin_remittance_confirm', {id: remittance.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('remittance' ~ remittance.id) }}">
                            <button type="submit">Confirm received</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="7">no records found</td></tr>
        {% endfor %}
        </tbody>
    </table>
    {{ knp_pagination_render(remittances) }}
{% endblock %}
