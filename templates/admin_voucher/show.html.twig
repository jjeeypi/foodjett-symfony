{% extends 'base.html.twig' %}

{% block title %}Voucher{% endblock %}

{% block body %}
    <h1>Voucher</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ voucher.id }}</td>
            </tr>
            <tr>
                <th>Code</th>
                <td>{{ voucher.code }}</td>
            </tr>
            <tr>
                <th>Scope</th>
                <td>{{ voucher.scope }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ voucher.type }}</td>
            </tr>
            <tr>
                <th>Value</th>
                <td>{{ voucher.value }}</td>
            </tr>
            <tr>
                <th>MinOrderAmount</th>
                <td>{{ voucher.minOrderAmount }}</td>
            </tr>
            <tr>
                <th>UsageLimitTotal</th>
                <td>{{ voucher.usageLimitTotal }}</td>
            </tr>
            <tr>
                <th>UsageLimitPerCustomer</th>
                <td>{{ voucher.usageLimitPerCustomer }}</td>
            </tr>
            <tr>
                <th>StartsAt</th>
                <td>{{ voucher.startsAt ? voucher.startsAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>EndsAt</th>
                <td>{{ voucher.endsAt ? voucher.endsAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>IsActive</th>
                <td>{{ voucher.isActive ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ voucher.createdAt ? voucher.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ voucher.updatedAt ? voucher.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_voucher_index') }}">back to list</a>

    <a href="{{ path('app_admin_voucher_edit', {'id': voucher.id}) }}">edit</a>

    {{ include('admin_voucher/_delete_form.html.twig') }}
{% endblock %}
