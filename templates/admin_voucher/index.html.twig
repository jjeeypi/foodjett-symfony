{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Platform vouchers | Foodjett admin{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <div class="eyebrow">Promotions</div>
            <h1>Platform vouchers</h1>
            <p>These work at every restaurant. Restaurants run their own vouchers from their dashboard.</p>
        </div>
        <div class="page-actions"><a class="btn btn-green" href="{{ path('app_admin_voucher_new') }}">{{ icon('plus', 'icon-sm') }} Create a voucher</a></div>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th>Code</th><th>Discount</th><th class="num">Minimum order</th><th>Used</th><th>Valid</th><th>Active</th><th></th></tr>
            </thead>
            <tbody>
            {% for voucher in vouchers %}
                <tr id="voucher-{{ voucher.code }}">
                    <td><div class="entity"><span class="thumb">{{ icon('ticket', 'icon-sm') }}</span><strong>{{ voucher.code }}</strong></div></td>
                    <td>{{ voucher.type == 'free_delivery' ? 'Free delivery' : (voucher.type == 'percentage' ? voucher.value ~ '%' : '₱' ~ voucher.value) }}</td>
                    <td class="num">₱{{ voucher.minOrderAmount }}</td>
                    <td>{{ voucher.redemptions|length }}{% if voucher.usageLimitTotal %} of {{ voucher.usageLimitTotal }}{% endif %}</td>
                    <td>{{ voucher.startsAt ? voucher.startsAt|date('M j') : 'now' }} to {{ voucher.endsAt ? voucher.endsAt|date('M j, Y') : 'no end' }}</td>
                    <td><span class="badge {{ voucher.active ? 'badge-green' }}">{{ voucher.active ? 'Yes' : 'No' }}</span></td>
                    <td class="actions">
                        <a class="btn btn-light btn-sm" href="{{ path('app_admin_voucher_show', {'id': voucher.id}) }}">show</a>
                        <a class="btn btn-light btn-sm" href="{{ path('app_admin_voucher_edit', {'id': voucher.id}) }}">edit</a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7">No vouchers yet.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {{ knp_pagination_render(vouchers) }}
{% endblock %}
