{% extends 'base.html.twig' %}

{% block title %}Vouchers | Foodjett admin{% endblock %}

{% block body %}
    <p><a href="{{ path('app_admin_dashboard') }}">Dashboard</a></p>
    <h1>Platform vouchers</h1>
    <p>These work at every restaurant. Restaurants run their own vouchers from their dashboard.</p>

    <table class="table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Discount</th>
                <th>Minimum order</th>
                <th>Used</th>
                <th>Valid</th>
                <th>Active</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for voucher in vouchers %}
            <tr id="voucher-{{ voucher.code }}">
                <td>{{ voucher.code }}</td>
                <td>{{ voucher.type == 'free_delivery' ? 'Free delivery' : (voucher.type == 'percentage' ? voucher.value ~ '%' : '₱' ~ voucher.value) }}</td>
                <td>₱{{ voucher.minOrderAmount }}</td>
                <td>{{ voucher.redemptions|length }}{% if voucher.usageLimitTotal %} of {{ voucher.usageLimitTotal }}{% endif %}</td>
                <td>{{ voucher.startsAt ? voucher.startsAt|date('M j') : 'now' }} to {{ voucher.endsAt ? voucher.endsAt|date('M j, Y') : 'no end' }}</td>
                <td>{{ voucher.active ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_admin_voucher_show', {'id': voucher.id}) }}">show</a>
                    <a href="{{ path('app_admin_voucher_edit', {'id': voucher.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">No vouchers yet.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {{ knp_pagination_render(vouchers) }}

    <a href="{{ path('app_admin_voucher_new') }}">Create a voucher</a>
{% endblock %}
