{% extends 'base.html.twig' %}

{% block title %}Voucher index{% endblock %}

{% block body %}
    <h1>Voucher index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Code</th>
                <th>Scope</th>
                <th>Type</th>
                <th>Value</th>
                <th>MinOrderAmount</th>
                <th>UsageLimitTotal</th>
                <th>UsageLimitPerCustomer</th>
                <th>StartsAt</th>
                <th>EndsAt</th>
                <th>IsActive</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for voucher in vouchers %}
            <tr>
                <td>{{ voucher.id }}</td>
                <td>{{ voucher.code }}</td>
                <td>{{ voucher.scope }}</td>
                <td>{{ voucher.type }}</td>
                <td>{{ voucher.value }}</td>
                <td>{{ voucher.minOrderAmount }}</td>
                <td>{{ voucher.usageLimitTotal }}</td>
                <td>{{ voucher.usageLimitPerCustomer }}</td>
                <td>{{ voucher.startsAt ? voucher.startsAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ voucher.endsAt ? voucher.endsAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ voucher.isActive ? 'Yes' : 'No' }}</td>
                <td>{{ voucher.createdAt ? voucher.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ voucher.updatedAt ? voucher.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_admin_voucher_show', {'id': voucher.id}) }}">show</a>
                    <a href="{{ path('app_admin_voucher_edit', {'id': voucher.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="14">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_admin_voucher_new') }}">Create new</a>
{% endblock %}
