{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon, status_badge %}

{% block title %}Rider payouts | Foodjett admin{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <div class="eyebrow">Money out</div>
            <h1>Rider payouts</h1>
            <p>Delivery earnings owed to each rider.</p>
        </div>
        <div class="page-actions"><a class="btn btn-light" href="{{ path('app_admin_restaurant_payout') }}">{{ icon('store', 'icon-sm') }} Restaurant payouts</a></div>
    </div>

    <div class="split">
        <div>
            <div class="toolbar">
                <nav class="tabs" aria-label="Payout status">
                    <a class="{{ status is empty ? 'current' }}" href="{{ path('app_admin_rider_payout') }}">All</a>
                    {% for value in statuses %}<a class="{{ status == value ? 'current' }}" href="{{ path('app_admin_rider_payout', {status: value}) }}">{{ value|capitalize }}</a>{% endfor %}
                </nav>
            </div>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr><th>Rider</th><th>Period</th><th class="num">Total</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                    {% for payout in payouts %}
                        <tr id="payout-{{ payout.id }}">
                            <td>
                                <a class="entity" href="{{ path('app_admin_rider_show', {id: payout.rider.id}) }}">
                                    <span class="avatar">{{ payout.rider.user.name|split(' ')|map(p => p|first)|slice(0, 2)|join|upper }}</span>
                                    <strong>{{ payout.rider.user.name }}</strong>
                                </a>
                            </td>
                            <td>{{ payout.periodStart|date('M j, Y') }} to {{ payout.periodEnd|date('M j, Y') }}</td>
                            <td class="num net"><b>₱{{ payout.totalAmount }}</b></td>
                            <td class="status">{{ status_badge(payout.status) }}{% if payout.paidAt %} <small class="subtle">{{ payout.paidAt|date('M j, Y') }}</small>{% endif %}</td>
                            <td class="actions">
                                {% if payout.status == 'pending' %}
                                    <form method="post" action="{{ path('app_admin_rider_payout_paid', {id: payout.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('payout' ~ payout.id) }}">
                                        <button type="submit" class="btn-green btn-sm">Mark paid</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5">no records found</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ knp_pagination_render(payouts) }}
        </div>

        <aside class="panel action-card">
            <h2>Generate</h2>
            <p class="subtle">One payout per rider: everything earned on orders delivered in the period. Riders already paid for an overlapping period are skipped.</p>
            {{ form_start(form, {action: path('app_admin_rider_payout_generate')}) }}
                {{ form_widget(form) }}
                <button type="submit" class="btn-green btn-block">Generate payouts</button>
            {{ form_end(form) }}
        </aside>
    </div>
{% endblock %}
