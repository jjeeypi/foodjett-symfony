{% extends 'base.html.twig' %}

{% block title %}CustomerAddress{% endblock %}

{% block body %}
    <h1>CustomerAddress</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ customer_address.id }}</td>
            </tr>
            <tr>
                <th>Label</th>
                <td>{{ customer_address.label }}</td>
            </tr>
            <tr>
                <th>AddressLine</th>
                <td>{{ customer_address.addressLine }}</td>
            </tr>
            <tr>
                <th>Landmark</th>
                <td>{{ customer_address.landmark }}</td>
            </tr>
            <tr>
                <th>DeliveryInstructions</th>
                <td>{{ customer_address.deliveryInstructions }}</td>
            </tr>
            <tr>
                <th>Latitude</th>
                <td>{{ customer_address.latitude }}</td>
            </tr>
            <tr>
                <th>Longitude</th>
                <td>{{ customer_address.longitude }}</td>
            </tr>
            <tr>
                <th>IsDefault</th>
                <td>{{ customer_address.isDefault ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ customer_address.createdAt ? customer_address.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ customer_address.updatedAt ? customer_address.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_customer_address_index') }}">back to list</a>

    <a href="{{ path('app_customer_address_edit', {'id': customer_address.id}) }}">edit</a>

    {{ include('customer_address/_delete_form.html.twig') }}
{% endblock %}
