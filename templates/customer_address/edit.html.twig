{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon %}

{% block title %}Edit address | Foodjett{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_customer_address_index') }}">{{ icon('back', 'icon-sm') }} Your addresses</a>
    <div class="page-head">
        <div>
            <div class="eyebrow">Where should we deliver?</div>
            <h1>Edit <span>address.</span></h1>
            <p>Type the street, a barangay or a landmark, use your location, or tap the map.</p>
        </div>
    </div>

    <section class="panel form-card">
        {{ include('customer_address/_form.html.twig', {'button_label': 'Update'}) }}
    </section>

    <section class="panel form-card">
        <h2>Remove this address</h2>
        <p class="subtle">Addresses used by past orders are kept for your order history.</p>
        {{ include('customer_address/_delete_form.html.twig') }}
    </section>
{% endblock %}
