{% extends 'base.html.twig' %}

{% block title %}Your addresses | Foodjett{% endblock %}

{% block body %}
    <p><a href="{{ path('app_account') }}">Your account</a></p>
    <h1>Your addresses</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Label</th>
                <th>Address</th>
                <th>Landmark</th>
                <th>Default</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for customer_address in customer_addresses %}
            <tr>
                <td>{{ customer_address.label }}</td>
                <td>{{ customer_address.addressLine }}</td>
                <td>{{ customer_address.landmark }}</td>
                <td>{{ customer_address.isDefault ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_customer_address_edit', {'id': customer_address.id}) }}">edit</a>
                    {{ include('customer_address/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">You have no saved addresses yet.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_customer_address_new') }}">Add an address</a>
{% endblock %}
