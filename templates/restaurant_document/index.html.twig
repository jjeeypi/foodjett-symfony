{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon, status_badge %}

{% block title %}Documents | Foodjett{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <div class="eyebrow">Paperwork</div>
            <h1>Documents</h1>
            <p>An admin checks every permit. Upload a new file when one is rejected.</p>
        </div>
    </div>

    <div class="split">
        <section class="panel">
            <div class="docs">
                {% for type in types %}
                    {% set document = documents[type] ?? null %}
                    <div class="doc {{ document ? document.status }}" id="document-{{ type }}">
                        <span class="pin-box">{{ icon('file') }}</span>
                        <span>
                            <strong>{{ type|replace({'_': ' '})|capitalize }}</strong>
                            <small>
                                {%- if document %}{% if document.rejectionReason %}Note from the admin: {{ document.rejectionReason }} · {% endif %}<a href="{{ path('app_restaurant_document_file', {id: document.id}) }}">view</a>
                                {%- else %}Not uploaded yet{% endif -%}
                            </small>
                        </span>
                        <span class="doc-actions">{{ status_badge(document ? document.status : 'missing') }}</span>
                    </div>
                {% endfor %}
            </div>
        </section>
        <aside class="panel">
            {% if form %}
                <h2>Upload a document</h2>
                {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <button type="submit">Upload</button>
                {{ form_end(form) }}
            {% else %}
                <h2>{{ icon('check') }} All set</h2>
                <p class="subtle">All documents are submitted.</p>
            {% endif %}
        </aside>
    </div>
{% endblock %}
