{% extends 'base.html.twig' %}

{% block title %}Order {{ order.orderNumber }} | Foodjett{% endblock %}

{% block body %}
    <div id="live" {{ turbo_stream_listen('orders/' ~ order.id ~ '/status', null, {withCredentials: true}) }} hidden></div>
    <p><a href="{{ path('app_orders') }}">All orders</a></p>

    <h1>Order {{ order.orderNumber }}</h1>
    <p id="status">Status: <strong>{{ order.status|replace({'_': ' '}) }}</strong></p>
    <p>
        From <a href="{{ path('app_restaurant_menu', {slug: order.restaurant.slug}) }}">{{ order.restaurant.name }}</a>,
        placed {{ order.placedAt|date('M j, Y g:i A') }}.
        {% if order.estimatedReadyAt %}Expected ready by {{ order.estimatedReadyAt|date('g:i A') }}.{% endif %}
    </p>
    {% if order.cancellationReason %}<p>Cancelled: {{ order.cancellationReason }}</p>{% endif %}

    <h2>Items</h2>
    <ul>
        {% for item in order.items %}
            <li>
                {{ item.quantity }} × {{ item.menuItem.name }}
                {% if item.menuItemVariant %}({{ item.menuItemVariant.name }}){% endif %}
                · PHP {{ item.unitPrice }} each
                {% for addon in item.addons %}<br>+ {{ addon.menuItemAddon.name }} (PHP {{ addon.price }}){% endfor %}
                {% if item.specialInstructions %}<br>Note: {{ item.specialInstructions }}{% endif %}
            </li>
        {% endfor %}
    </ul>

    <dl id="totals">
        <dt>Subtotal</dt><dd>PHP {{ order.subtotal }}</dd>
        <dt>Delivery fee</dt><dd>PHP {{ order.deliveryFee }}</dd>
        <dt>Service fee</dt><dd>PHP {{ order.serviceFee }}</dd>
        {% if order.discountAmount > 0 %}<dt>Discount</dt><dd>- PHP {{ order.discountAmount }}</dd>{% endif %}
        {% if order.tipAmount > 0 %}<dt>Rider tip</dt><dd>PHP {{ order.tipAmount }}</dd>{% endif %}
        <dt>Total</dt><dd><strong>PHP {{ order.totalAmount }}</strong></dd>
        <dt>Payment</dt>
        <dd>
            {{ order.paymentMethod|upper }}
            {% if order.payment %}· {{ order.payment.status|replace({'_': ' '}) }}
                {% if order.payment.refundedAmount > 0 %}· refunded PHP {{ order.payment.refundedAmount }}{% endif %}
            {% endif %}
        </dd>
    </dl>

    <h2>Delivery</h2>
    <p>
        {{ order.customerAddress.label }}: {{ order.customerAddress.addressLine }}
        {% if order.customerAddress.landmark %}(near {{ order.customerAddress.landmark }}){% endif %}
    </p>
    {% if order.rider %}
        <p id="rider">
            Rider: {{ order.rider.user.name }} ({{ order.rider.vehicleType }})
            {% if rider_location_visible and order.rider.currentLatitude %}
                · last seen at {{ order.rider.currentLatitude }}, {{ order.rider.currentLongitude }}
                {% if order.rider.lastLocationAt %}({{ order.rider.lastLocationAt|date('g:i A') }}){% endif %}
            {% endif %}
        </p>
    {% endif %}

    {% if order.status not in constant('App\\Entity\\Order::TERMINAL_STATUSES') or order.conversations is not empty %}
        <h2>Messages</h2>
        {% if order.acceptedAt %}
            <form method="post" action="{{ path('app_conversation_start', {id: order.id, type: 'customer_restaurant'}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('chat' ~ order.id) }}">
                <button type="submit">Message the restaurant</button>
            </form>
        {% endif %}
        {% if order.rider %}
            <form method="post" action="{{ path('app_conversation_start', {id: order.id, type: 'customer_rider'}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('chat' ~ order.id) }}">
                <button type="submit">Message the rider</button>
            </form>
        {% endif %}
    {% endif %}

    <h2>Timeline</h2>
    <ol id="timeline">
        {% for entry in history %}
            <li>{{ entry.createdAt|date('M j, g:i A') }}: {{ entry.status|replace({'_': ' '}) }}{% if entry.note %} · {{ entry.note }}{% endif %}</li>
        {% endfor %}
    </ol>

    {% if cancel_form %}
        <h2>Cancel this order</h2>
        {{ form_start(cancel_form, {action: path('app_order_cancel', {id: order.id})}) }}
            {{ form_widget(cancel_form) }}
            <button type="submit">Cancel order</button>
        {{ form_end(cancel_form) }}
    {% endif %}

    {% if review_form %}
        <h2>Rate this order</h2>
        {{ form_start(review_form, {action: path('app_order_review', {id: order.id})}) }}
            {{ form_errors(review_form) }}
            {{ form_widget(review_form) }}
            <button type="submit">Send review</button>
        {{ form_end(review_form) }}
    {% endif %}

    {% if order.status in constant('App\\Entity\\Order::TERMINAL_STATUSES') %}
        <form method="post" action="{{ path('app_order_reorder', {id: order.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('reorder' ~ order.id) }}">
            <button type="submit">Order these items again</button>
        </form>
    {% endif %}

    {% if report_form %}
        <h2>Report a problem</h2>
        {{ form_start(report_form, {action: path('app_order_report', {id: order.id})}) }}
            {{ form_widget(report_form) }}
            <button type="submit">Send report</button>
        {{ form_end(report_form) }}
    {% endif %}
{% endblock %}
