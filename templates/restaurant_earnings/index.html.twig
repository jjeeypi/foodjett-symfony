{% extends 'base.html.twig' %}

{% block title %}Earnings | Foodjett{% endblock %}

{% block body %}
    <p><a href="{{ path('app_restaurant_dashboard') }}">Dashboard</a></p>
    <h1>Earnings</h1>

    <table id="periods">
        <thead><tr><th>Period</th><th>Delivered orders</th><th>Sales</th><th>Commission</th><th>Net</th></tr></thead>
        <tbody>
            {% for label, period in periods %}
                <tr>
                    <td>{{ label }}</td>
                    <td>{{ period.orders }}</td>
                    <td>PHP {{ period.gross }}</td>
                    <td>PHP {{ period.commission }}</td>
                    <td>PHP {{ period.net }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <h2>Payouts</h2>
    <table id="payouts">
        <thead><tr><th>Period</th><th>Sales</th><th>Commission</th><th>Paid to you</th><th>Status</th></tr></thead>
        <tbody>
            {% for payout in payouts %}
                <tr>
                    <td>{{ payout.periodStart|date('M j') }} to {{ payout.periodEnd|date('M j, Y') }}</td>
                    <td>PHP {{ payout.grossSales }}</td>
                    <td>PHP {{ payout.commissionDeducted }}</td>
                    <td>PHP {{ payout.netAmount }}</td>
                    <td>{{ payout.status }}{% if payout.paidAt %} on {{ payout.paidAt|date('M j, Y') }}{% endif %}</td>
                </tr>
            {% else %}
                <tr><td colspan="5">No payouts yet.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    {{ knp_pagination_render(payouts) }}
{% endblock %}
