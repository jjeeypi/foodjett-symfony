{% extends 'base.html.twig' %}
{% from 'base.html.twig' import icon, status_badge %}

{% block title %}Earnings | Foodjett{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <div class="eyebrow">Money</div>
            <h1>Earnings</h1>
            <p>Sales from delivered orders, after the Foodjett commission.</p>
        </div>
    </div>

    <dl class="stats">
        {% for label, period in periods %}
            <div><dt>{{ label }}</dt><dd>₱{{ period.net }}</dd></div>
        {% endfor %}
    </dl>

    <section class="panel">
        <h2>By period</h2>
        <div class="table-wrap">
            <table id="periods">
                <thead><tr><th>Period</th><th class="num">Delivered orders</th><th class="num">Sales</th><th class="num">Commission</th><th class="num">Net</th></tr></thead>
                <tbody>
                    {% for label, period in periods %}
                        <tr>
                            <td>{{ label }}</td>
                            <td class="num">{{ period.orders }}</td>
                            <td class="num">₱{{ period.gross }}</td>
                            <td class="num">₱{{ period.commission }}</td>
                            <td class="num"><b>₱{{ period.net }}</b></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <h2>Payouts</h2>
        <div class="table-wrap">
            <table id="payouts">
                <thead><tr><th>Period</th><th class="num">Sales</th><th class="num">Commission</th><th class="num">Paid to you</th><th>Status</th></tr></thead>
                <tbody>
                    {% for payout in payouts %}
                        <tr>
                            <td>{{ payout.periodStart|date('M j') }} to {{ payout.periodEnd|date('M j, Y') }}</td>
                            <td class="num">₱{{ payout.grossSales }}</td>
                            <td class="num">₱{{ payout.commissionDeducted }}</td>
                            <td class="num"><b>₱{{ payout.netAmount }}</b></td>
                            <td>{{ status_badge(payout.status) }}{% if payout.paidAt %} <small class="subtle">on {{ payout.paidAt|date('M j, Y') }}</small>{% endif %}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5">No payouts yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {{ knp_pagination_render(payouts) }}
    </section>
{% endblock %}
