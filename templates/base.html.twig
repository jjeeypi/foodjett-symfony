<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <title>{% block title %}Foodjett{% endblock %}</title>
        {# Live pages refresh in place when the server signals a change over Mercure. #}
        {{ turbo_refresh_method('morph') }}
        {{ turbo_refresh_scroll('preserve') }}
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22><path d=%22m13 2-9 12h7l-1 8 10-13h-7Z%22 fill=%22%23c7ed8c%22 stroke=%22%23273826%22 stroke-width=%221.6%22 stroke-linejoin=%22round%22/></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Manrope:wght@600;700;800&display=swap">
        {% block stylesheets %}{% endblock %}
        {# Applies a hidden sidebar before the first paint so it does not flash open; sidebar_controller.js keeps it in sync. #}
        <script>try { if ('collapsed' === localStorage.getItem('foodjett.sidebar')) document.documentElement.classList.add('sidebar-collapsed'); } catch (e) {}</script>

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block layout %}
        {% if auth_page is defined %}
            {# Sign-in, sign-up and password pages: a food photo beside a focused form. #}
            <div class="auth">
                <aside class="auth-art">
                    <img src="{{ asset(auth_page.image ?? 'images/catalog/covers/maxs-restaurant.webp') }}" alt="" width="1024" height="576">
                    <a class="logo" href="{{ path('app_home') }}" aria-label="Foodjett home" style="margin-left: 0">foodjett{{ icon('bolt') }}</a>
                    <div>
                        <div class="eyebrow">{{ auth_page.eyebrow ?? 'Your daily good food' }}</div>
                        <h2>{{ (auth_page.headline ?? 'Good food.<br>Good mood.')|raw }}</h2>
                    </div>
                    <p class="art-foot">Fifty local favorites around Dumaguete, delivered fresh to your door.</p>
                </aside>
                <main class="auth-main content">
                    <div class="auth-card{{ auth_page.wide ?? false ? ' auth-wide' }}">
                        {% block body %}{% endblock %}
                    </div>
                </main>
            </div>
        {% else %}
        <div class="app">
            <aside class="sidebar" id="sidebar">
                <a class="logo" href="{{ path(home_route) }}" aria-label="Foodjett home">foodjett{{ icon('bolt') }}</a>
                <button type="button" class="icon-button sidebar-toggle" data-controller="sidebar" data-action="sidebar#toggle" aria-controls="sidebar" aria-expanded="true" aria-label="Hide the menu" title="Hide the menu">{{ icon('sidebar') }}</button>
                <div class="workspace-label">{{ workspace }}</div>

                <nav class="side-nav" aria-label="Main navigation">
                    {% for item in nav %}
                        {% set active = false %}
                        {% for prefix in item[3]|split('|') %}
                            {% if route starts with prefix %}{% set active = true %}{% endif %}
                        {% endfor %}
                        <a class="nav-item{{ active ? ' active' }}{{ loop.index > 5 ? ' mobile-hidden' }}" href="{{ path(item[2]) }}" {% if active %}aria-current="page"{% endif %} title="{{ item[0] }}">
                            {{ icon(item[1]) }}<span>{{ item[0] }}</span>
                        </a>
                    {% endfor %}
                </nav>

                <div class="sidebar-bottom">
                    {% if user and is_granted('ROLE_CUSTOMER') %}
                        <div class="little-promo">
                            {{ icon('bike', 'icon-lg') }}
                            <strong>Good food. Great perks.</strong>
                            <p>Your next favorite meal comes with a little extra.</p>
                            <a href="{{ path('app_restaurants') }}">Explore restaurants {{ icon('arrow', 'icon-sm') }}</a>
                        </div>
                    {% elseif user and is_granted('ROLE_RIDER') %}
                        <div class="little-promo">
                            {{ icon('bike', 'icon-lg') }}
                            <strong>A good day starts with a safe ride.</strong>
                            <p>Take your time. We’re with you every kilometer.</p>
                        </div>
                    {% endif %}
                    {% if user %}
                        <a class="side-link" href="{{ path('app_support_ticket_index') }}" title="Help & support">{{ icon('help') }}<span>Help & support</span></a>
                        <div class="profile">
                            <span class="avatar">
                                {%- if user.avatarPath %}<img src="{{ asset(user.avatarPath) }}" alt="">{% else %}{{ user.name|split(' ')|map(p => p|first)|slice(0, 2)|join|upper }}{% endif -%}
                            </span>
                            <span class="profile-text">
                                <span class="profile-name">Hey, {{ user.name|split(' ')|first }}</span>
                                <span class="profile-note">Signed in as {{ user.name }} ({{ user.role }})</span>
                            </span>
                            <a class="icon-button" href="{{ path('app_logout') }}" title="Log out" aria-label="Log out">{{ icon('logout') }}</a>
                        </div>
                    {% else %}
                        <div class="little-promo">
                            {{ icon('store', 'icon-lg') }}
                            <strong>Grow with Foodjett.</strong>
                            <p>Sell on Foodjett or deliver with us around Dumaguete.</p>
                            <a href="{{ path('app_register_restaurant') }}">Add your restaurant {{ icon('arrow', 'icon-sm') }}</a>
                            <a href="{{ path('app_register_rider') }}">Ride with us {{ icon('arrow', 'icon-sm') }}</a>
                        </div>
                    {% endif %}
                </div>
            </aside>

            <div class="main-shell">
                <header class="topbar">
                    {% block topbar %}
                        {% if is_granted('ROLE_CUSTOMER') %}
                            {% set default = user.customer ? user.customer.addresses|filter(a => a.default)|first : null %}
                            <a class="topbar-place" href="{{ path('app_customer_address_index') }}">
                                <span class="pin-box">{{ icon('pin') }}</span>
                                <span><small>Deliver to</small><strong>{{ default ? default.addressLine : 'Add a delivery address' }} {{ icon('down', 'icon-sm') }}</strong></span>
                            </a>
                            <div class="topbar-actions">
                                <span class="status-note"><i class="dot"></i> Delivering good food, every day</span>
                                {% set cartCount = user.customer ? user.customer.cartItems|reduce((sum, i) => sum + i.quantity, 0) : 0 %}
                                <a class="cart-button" href="{{ path('app_cart') }}" aria-label="Your cart, {{ cartCount }} items">{{ icon('bag', 'icon-sm') }}<span class="cart-label">Your cart</span><span class="cart-count">{{ cartCount }}</span></a>
                            </div>
                        {% elseif is_granted('ROLE_RIDER') and user.rider %}
                            {% set availability = user.rider.availabilityStatus %}
                            {% set statusPage = user.rider.approvalStatus == 'approved' ? path('app_rider_status') : path('app_rider_dashboard') %}
                            <a class="topbar-place" href="{{ statusPage }}">
                                <span class="pin-box">{{ icon('pin') }}</span>
                                <span><small>Your delivery area</small><strong>Dumaguete City {{ icon('down', 'icon-sm') }}</strong></span>
                            </a>
                            <div class="topbar-actions">
                                <a class="toggle{{ availability == 'available' ? ' on' }}" href="{{ statusPage }}">
                                    <i class="dot{{ availability == 'offline' ? ' dot-off' }}"></i>
                                    {{ availability == 'available' ? 'You’re online' : (availability == 'busy' ? 'On a delivery' : 'You’re offline') }}
                                    <span class="toggle-track"></span>
                                </a>
                            </div>
                        {% elseif is_granted('ROLE_RESTAURANT') and user.restaurant %}
                            {% set store = user.restaurant %}
                            <a class="topbar-place" href="{{ path('app_restaurant_profile') }}">
                                <span class="pin-box">{{ icon('store') }}</span>
                                <span><small>Your restaurant</small><strong>{{ store.name }}</strong></span>
                            </a>
                            <div class="topbar-actions">
                                <span class="badge {{ store.openNow ? 'badge-green' : '' }}"><i class="dot{{ store.openNow ? '' : ' dot-off' }}"></i> {{ store.openNow ? 'Open now' : 'Closed' }}</span>
                                <a class="btn btn-green btn-sm" href="{{ path('app_restaurant_orders') }}">{{ icon('receipt', 'icon-sm') }} Orders</a>
                            </div>
                        {% elseif is_granted('ROLE_ADMIN') %}
                            <span class="topbar-place">
                                <span class="pin-box">{{ icon('shield') }}</span>
                                <span><small>Foodjett</small><strong>Admin console</strong></span>
                            </span>
                            <div class="topbar-actions">
                                <span class="status-note">{{ 'now'|date('l, F j') }}</span>
                            </div>
                        {% else %}
                            <a class="topbar-place" href="{{ path('app_restaurants') }}">
                                <span class="pin-box">{{ icon('pin') }}</span>
                                <span><small>Deliver to</small><strong>Dumaguete City {{ icon('down', 'icon-sm') }}</strong></span>
                            </a>
                            <div class="topbar-actions">
                                <a class="btn btn-light btn-sm" href="{{ path('app_login') }}">Log in</a>
                                <a class="btn btn-green btn-sm" href="{{ path('app_register') }}">Sign up</a>
                            </div>
                        {% endif %}
                    {% endblock %}
                    {% if user %}
                        {# Phones hide the sidebar footer, so the account, help and log-out links live here. #}
                        <details class="account-menu">
                            <summary aria-label="Account menu" title="Account menu">
                                <span class="avatar">
                                    {%- if user.avatarPath %}<img src="{{ asset(user.avatarPath) }}" alt="">{% else %}{{ user.name|split(' ')|map(p => p|first)|slice(0, 2)|join|upper }}{% endif -%}
                                </span>
                            </summary>
                            <div class="account-menu-panel">
                                <p class="account-menu-head"><strong>{{ user.name }}</strong><span>Signed in as {{ user.role }}</span></p>
                                {% if account_route %}<a href="{{ path(account_route) }}">{{ icon('user', 'icon-sm') }} My account</a>{% endif %}
                                {% if is_granted('ROLE_RIDER') and user.rider and user.rider.approvalStatus == 'approved' %}<a href="{{ path('app_rider_finance') }}">{{ icon('wallet', 'icon-sm') }} Earnings</a>{% endif %}
                                <a href="{{ path('app_support_ticket_index') }}">{{ icon('help', 'icon-sm') }} Help &amp; support</a>
                                <a href="{{ path('app_logout') }}">{{ icon('logout', 'icon-sm') }} Log out</a>
                            </div>
                        </details>
                    {% endif %}
                </header>

                <main class="content">
                    {{ block('body') }}
                </main>

                <footer class="site-footer">
                    <span class="brand-line">A little local love in every order.</span>
                    <span>Food and restaurant pictures are AI-generated illustrations, not photos of the actual dishes.</span>
                </footer>
            </div>
        </div>
        {% endif %}
        {% endblock %}

        {% set flashes = app.flashes %}
        {% if flashes is not empty %}
            <div class="flashes">
                {% for type, messages in flashes %}
                    {% for message in messages %}
                        <p class="flash flash-{{ type }}" role="status">{{ icon(type == 'success' ? 'check' : 'bolt', 'icon-sm') }}{{ message }}<button type="button" aria-label="Dismiss" onclick="this.parentElement.remove()">{{ icon('close', 'icon-sm') }}</button></p>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}
    </body>
</html>
