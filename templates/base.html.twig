        ['Orders', 'receipt', 'app_restaurant_orders', 'app_restaurant_order'],
        ['Menu', 'menu-book', 'app_menu_item_index', 'app_menu_'],
        ['Messages', 'message', 'app_messages', 'app_messages|app_conversation'],
        ['Hours', 'clock', 'app_restaurant_hours', 'app_restaurant_hours'],
        ['Vouchers', 'ticket', 'app_restaurant_voucher_index', 'app_restaurant_voucher'],
        ['Reviews', 'star', 'app_restaurant_reviews', 'app_restaurant_reviews'],
        ['Earnings', 'wallet', 'app_restaurant_earnings', 'app_restaurant_earnings'],
        ['Documents', 'file', 'app_restaurant_documents', 'app_restaurant_documents'],
