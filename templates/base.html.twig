{%- elseif is_granted('ROLE_RIDER') -%}
    {%- set home_route = 'app_rider_dashboard' -%}
    {%- set account_route = 'app_rider_account' -%}
    {%- set workspace = 'Rider workspace' -%}
    {%- set nav = [
        ['Home', 'home', 'app_rider_dashboard', 'app_rider_dashboard'],
        ['Order pool', 'bag', 'app_rider_pool', 'app_rider_pool'],
