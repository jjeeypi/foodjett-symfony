    {%- set nav = [
        ['Explore', 'home', 'app_home', 'app_home|app_restaurant|app_search'],
        ['My orders', 'bag', 'app_orders', 'app_order'],
        ['Favorites', 'heart', 'app_favorites', 'app_favorite'],
