<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Foodjett{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🍽️</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {# Plain markup on purpose: the styled frontend is built later from the mockup. #}
        <header>
            <nav>
                <a href="{{ path('app_home') }}">Foodjett</a>
                | <a href="{{ path('app_restaurants') }}">Restaurants</a>
                | <a href="{{ path('app_search') }}">Search</a>
                {% if is_granted('ROLE_CUSTOMER') %}
                    | <a href="{{ path('app_cart') }}">Cart</a>
                    | <a href="{{ path('app_orders') }}">Orders</a>
                    | <a href="{{ path('app_account') }}">Account</a>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    | <a href="{{ path('app_admin_dashboard') }}">Admin</a>
                {% endif %}
                {% if is_granted('ROLE_RIDER') %}
                    | <a href="{{ path('app_rider_dashboard') }}">Rider</a>
                    | <a href="{{ path('app_rider_pool') }}">Pool</a>
                {% endif %}
                {% if is_granted('ROLE_RESTAURANT') %}
                    | <a href="{{ path('app_restaurant_dashboard') }}">Dashboard</a>
                    | <a href="{{ path('app_restaurant_orders') }}">Orders</a>
                    | <a href="{{ path('app_menu_item_index') }}">Menu</a>
                {% endif %}
                {% if app.user %}
                    | <a href="{{ path('app_messages') }}">Messages</a>
                    | <a href="{{ path('app_support_ticket_index') }}">Help</a>
                    | Signed in as {{ app.user.name }} ({{ app.user.role }})
                    | <a href="{{ path('app_logout') }}">Log out</a>
                {% else %}
                    | <a href="{{ path('app_login') }}">Log in</a>
                {% endif %}
            </nav>
        </header>

        <main>
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <p class="flash flash-{{ type }}" role="status">{{ message }}</p>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
