{#- Icon from assets/images/icons.svg. Child templates: {% from 'base.html.twig' import icon %} -#}
{% macro icon(name, class = '') -%}
    <svg class="icon {{ class }}" aria-hidden="true"><use href="{{ asset('images/icons.svg') }}#{{ name }}"></use></svg>
{%- endmacro %}
{#- A colored pill for any status word: orders, applications, accounts, payouts, documents, tickets. -#}
{% macro status_badge(status) -%}
    {%- set value = status ?? 'missing' -%}
    {%- if value in ['delivered', 'approved', 'active', 'verified', 'paid', 'resolved', 'confirmed', 'available', 'open', 'completed', 'succeeded'] -%}
        {%- set tone = 'badge-green' -%}
    {%- elseif value starts with 'rejected' or value starts with 'cancelled' or value starts with 'failed' or value in ['suspended', 'removed', 'refunded', 'missing', 'expired', 'offline'] -%}
        {%- set tone = 'badge-danger' -%}
    {%- elseif value in ['picked_up', 'on_the_way', 'arrived', 'in_progress', 'busy', 'closed'] -%}
        {%- set tone = 'badge-ink' -%}
    {%- else -%}
        {%- set tone = 'badge-warn' -%}
    {%- endif -%}
    <span class="badge {{ tone }}">{{ value|replace({'_': ' '}) }}</span>
{%- endmacro %}
{#- The restaurant's cover photo, or a drawn cover with its food icon when it has not uploaded one. -#}
{% macro cover(restaurant, width = 1024, height = 576, lazy = false) -%}
    {% if restaurant.coverPhotoPath %}
        <img src="{{ asset(restaurant.coverPhotoPath) }}" alt="" width="{{ width }}" height="{{ height }}"{{ lazy ? ' loading="lazy"' }}>
    {% else %}
        {%- set art = 'crave-all' -%}
        {%- for key, craving in constant('App\\Entity\\Restaurant::CRAVINGS')|reverse -%}
            {%- if restaurant.matchesCraving(key) %}{% set art = craving.icon %}{% endif -%}
        {%- endfor -%}
        <span class="cover-fallback" aria-hidden="true">
            {% for spot in 1..6 %}<svg class="icon spot-{{ spot }}"><use href="{{ asset('images/icons.svg') }}#{{ art }}"></use></svg>{% endfor %}
            <b>{{ restaurant.name|first|upper }}</b>
        </span>
    {% endif %}
{%- endmacro %}
{#- Restaurant card used by explore, the restaurant list, search and favorites. -#}
{% macro restaurant_card(restaurant, favoriteIds = [], distance = null) -%}
    {% from _self import icon, cover %}
    {% set saved = (restaurant.id ~ '') in favoriteIds %}
    <article class="restaurant-card" id="restaurant-{{ restaurant.id }}">
        <a class="card-photo" href="{{ path('app_restaurant_menu', {slug: restaurant.slug}) }}" tabindex="-1" aria-hidden="true">
            {{ cover(restaurant, 640, 360, true) }}
            <span class="food-tag{{ restaurant.openNow ? '' : ' closed' }}">{% if restaurant.openNow %}{{ icon('bolt', 'icon-sm') }} {{ restaurant.kindLabel }}{% else %}Closed now{% endif %}</span>
        </a>
        {% if is_granted('ROLE_CUSTOMER') %}
            <form class="favorite-form" method="post" action="{{ path('app_favorite_toggle', {slug: restaurant.slug}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('favorite') }}">
                <input type="hidden" name="back" value="{{ app.request.requestUri }}#restaurant-{{ restaurant.id }}">
                <button class="favorite{{ saved ? ' saved' }}" type="submit" aria-pressed="{{ saved ? 'true' : 'false' }}" aria-label="{{ saved ? 'Remove ' ~ restaurant.name ~ ' from favorites' : 'Save ' ~ restaurant.name }}">{{ icon('heart', 'icon-sm') }}</button>
            </form>
        {% endif %}
        <a class="card-body" href="{{ path('app_restaurant_menu', {slug: restaurant.slug}) }}">
            <span class="card-title">
                <h3>{{ restaurant.name }}</h3>
                <span class="rating">{{ icon('star') }}<b>{{ restaurant.averageRating|number_format(1) }}</b><small>({{ restaurant.reviews|length }})</small></span>
            </span>
            <p>{{ restaurant.cuisineType }}{% if restaurant.description %} · {{ restaurant.description|length > 72 ? restaurant.description|slice(0, 70)|trim ~ '…' : restaurant.description }}{% endif %}</p>
            <span class="card-meta">
                <span>{{ icon('clock') }}{{ restaurant.defaultPrepTimeMinutes }}–{{ restaurant.defaultPrepTimeMinutes + 15 }} min</span>
                {% if distance is not null %}<span>{{ icon('pin') }}{{ distance|number_format(1) }} km</span>{% endif %}
                <span class="{{ restaurant.minOrderAmount > 0 ? '' : 'free' }}">{{ icon('bag') }}{{ restaurant.minOrderAmount > 0 ? 'Min. ₱' ~ restaurant.minOrderAmount|number_format(0) : 'No minimum' }}</span>
            </span>
        </a>
    </article>
{%- endmacro %}
{% from _self import icon %}
{%- set route = app.request.attributes.get('_route') ?? '' -%}
{%- set user = app.user -%}
