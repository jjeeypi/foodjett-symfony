# Docker Compose secrets template. Copy this file to .env.docker.local (gitignored)
# and replace every change-me value with a long random one before running `docker compose up`.
# Use URL-safe alphanumeric values: DATABASE_URL embeds the database password.

MARIADB_DATABASE=foodjett
MARIADB_USER=foodjett
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too
# Must repeat the three values above.
DATABASE_URL=mysql://foodjett:change-me@mariadb:3306/foodjett?serverVersion=mariadb-10.4.32&charset=utf8mb4

APP_SECRET=change-me

# All three Mercure values must be identical.
MERCURE_JWT_SECRET=change-me
MERCURE_PUBLISHER_JWT_KEY=change-me
MERCURE_SUBSCRIBER_JWT_KEY=change-me

# Optional: loads the 50 demo restaurants and their menus on first start. Every owner account
# (<slug>@restaurants.foodjett.test) gets this password. Leave it empty for an empty platform.
SEED_CATALOG_PASSWORD=
